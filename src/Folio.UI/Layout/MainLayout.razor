@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.Extensions.DependencyInjection
@inject ILibraryService Library
@inject IServiceScopeFactory Scopes
@inject IAppPreferencesService Preferences
@inject IFilePickerService FilePicker
@inject IJSRuntime JS
@inject NotificationService Notifications
@inject IDialogService Dialogs
@inject ImportInbox Inbox
@inject IPlatformCapabilities Platform
@inject NavigationManager Navigation
@inject FolioNavigator Navigator
@inject LibraryEvents Events
@inject StageState Stage

<MudThemeProvider Theme="_theme" IsDarkMode="@Preferences.Current.DarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<div class="folio-app @PhaseClass" data-theme="@(Preferences.Current.DarkMode ? "dark" : "light")">
    <div class="folio-library-shell @(Preferences.Current.SidebarCollapsed ? "sidebar-collapsed" : "") @(_inReader && Stage.Phase == StagePhase.None ? "is-covered" : "") @(Stage.Scene != null && Stage.Available ? "stage-on" : "")" inert="@(_inReader || Stage.Phase != StagePhase.None)">
        <a class="folio-skip-link" href="@SkipTarget">Skip to content</a>
        <aside class="folio-sidebar" aria-label="Main navigation">
            <button class="folio-brand" @onclick="() => Go(FolioRoutes.Home)" aria-label="Folio home" title="Folio home">
                <span class="folio-wordmark">FOLIO</span>
            </button>
            <nav aria-label="Library">
            <div class="folio-nav-section">[ WORKSPACE ]</div>
            <button class="folio-nav-link @Active(_route.Home || (_route.Shelf && _route.ShelfId == null && _route.Status == null))" aria-current="@Current(_route.Home)" @onclick="() => Go(FolioRoutes.Home)" title="Library"><MudIcon Icon="@Icons.Material.Outlined.LocalLibrary" /><span>Library</span><small>@_counts.All</small></button>
            <div class="folio-nav-section">[ READING ]</div>
            <button class="folio-nav-link @Active(_route.Status == ReadingStatus.Reading)" @onclick="() => Go(FolioRoutes.Shelf(status: ReadingStatus.Reading))" title="Currently reading"><MudIcon Icon="@Icons.Material.Outlined.AutoStories" /><span>Currently reading</span><small>@_counts.Reading</small></button>
            <button class="folio-nav-link @Active(_route.Status == ReadingStatus.WantToRead)" @onclick="() => Go(FolioRoutes.Shelf(status: ReadingStatus.WantToRead))" title="Want to read"><MudIcon Icon="@Icons.Material.Outlined.BookmarkBorder" /><span>Want to read</span><small>@_counts.WantToRead</small></button>
            <button class="folio-nav-link @Active(_route.Status == ReadingStatus.Finished)" @onclick="() => Go(FolioRoutes.Shelf(status: ReadingStatus.Finished))" title="Finished"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" /><span>Finished</span><small>@_counts.Finished</small></button>
            <div class="folio-nav-section folio-shelves-heading"><span>[ SHELVES ]</span><div class="folio-shelf-actions"><button aria-label="Manage shelves" title="Manage shelves" @onclick="ManageShelves"><MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" /></button><button aria-label="Create shelf" title="Create shelf" @onclick="CreateShelf"><MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" /></button></div></div>
            <div class="folio-shelves-list" role="region" aria-label="Shelves" tabindex="0">
                @for (var i = 0; i < _shelves.Count; i++)
                {
                    var shelf = _shelves[i]; var number = i + 1;
                    <button class="folio-nav-link @Active(_route.ShelfId == shelf.Id)" aria-current="@Current(_route.ShelfId == shelf.Id)" @onclick="() => Go(FolioRoutes.Shelf(shelf.Id))" title="@shelf.Name"><MudIcon Icon="@Icons.Material.Outlined.Folder" /><span>@shelf.Name</span>@if (number <= 9) { <small class="folio-mono" aria-hidden="true">@number</small> }</button>
                }
                @if (_shelves.Count == 0) { <p class="folio-sidebar-hint">Create a shelf to organize your books.</p> }
            </div>
            </nav>
            <div class="folio-sidebar-bottom">
                <button class="folio-nav-link @Active(_route.Trash)" aria-current="@Current(_route.Trash)" @onclick="() => Go(FolioRoutes.Trash)" title="Trash"><MudIcon Icon="@Icons.Material.Outlined.Delete" /><span>Trash</span><small>@_counts.Trash</small></button>
                <button class="folio-nav-link @Active(_route.Settings)" aria-current="@Current(_route.Settings)" @onclick="() => Go(FolioRoutes.Settings)" title="Settings"><MudIcon Icon="@Icons.Material.Outlined.Settings" /><span>Settings</span></button>
            </div>
        </aside>
        <section class="folio-shell-main">
            <header class="folio-app-header">
                <button class="folio-icon-button" @onclick="ToggleSidebar" aria-label="Toggle sidebar"><MudIcon Icon="@Icons.Material.Outlined.Menu" /></button>
                <span class="folio-header-context folio-mono">[ @HeaderTitle.ToUpperInvariant() ]</span>
                @if (!_route.Settings)
                {
                <label class="folio-global-search"><MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" />
                    <input id="folio-library-search" type="search" aria-label="Search library" placeholder="Search library… Enter for PDF text" value="@_search" @oninput="SearchInput" @onkeydown="SearchKey" /><kbd>Ctrl K</kbd>
                </label>
                }
                else { <span class="folio-header-spacer"></span> }
                <button class="folio-icon-button" @onclick="ToggleTheme" aria-label="Toggle light and dark theme"><MudIcon Icon="@(Preferences.Current.DarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" Size="Size.Small" /></button>
                <BracketButton Label="ADD BOOKS" Class="folio-add-books" AriaLabel="Add books" OnClick="ImportBooks" Disabled="@_importing" />
                @if (Platform.CanImportFolders) {
                <button class="folio-icon-button" title="Import folder" aria-label="Import folder" @onclick="ImportFolder" disabled="@_importing"><MudIcon Icon="@Icons.Material.Outlined.CreateNewFolder" /></button>
                }
            </header>
            <div class="folio-stage-layer"><StageHost @ref="_stage" Suspended="@(_inReader && Stage.Phase is StagePhase.None)" /></div>
            <main id="folio-main" class="folio-page-body" tabindex="-1">
                @if (!_inReader) { <CascadingValue Value="this" IsFixed="true">@Body</CascadingValue> }
            </main>
        </section>
    </div>
    @if (_inReader) { <CascadingValue Value="this" IsFixed="true">@Body</CascadingValue> }
    <NotificationCenter>
    @if (_importing || _importResults.Count > 0)
    {
        <section class="folio-notification-card folio-import-panel" aria-live="polite">
            <div class="folio-notification-heading"><MudIcon Icon="@(_importResults.Any(r => r.Error != null) ? Icons.Material.Outlined.ErrorOutline : Icons.Material.Outlined.Info)" Size="Size.Small" /><strong>@(_importing ? "Importing books" : _importCancelled ? "Import stopped" : _importResults.Any(r => r.Error != null) ? "Import finished with issues" : "Import complete")</strong>
                @if (_importing) { <button class="folio-subtle-btn" @onclick="() => _importCancellation?.Cancel()">Cancel</button> }
                else { <button class="folio-icon-button" aria-label="Dismiss import results" @onclick="() => _importResults.Clear()"><MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" /></button> }
            </div>
            @if (_importing) { <MudProgressLinear Color="Color.Primary" Value="@(_importProgress * 100)" /> }
            else { <p>@_importResults.Count(r => r.Error == null && r.IsNew) added · @_importResults.Count(r => r.Error != null) failed</p> }
            @foreach (var result in _importResults) { <div class="folio-import-result"><span>@result.Book.Title</span><small class="@(result.Error != null ? "folio-error-text" : "")">@(result.Error ?? (result.IsNew ? "Added to library" : "Already in library"))</small></div> }
        </section>
    }
    </NotificationCenter>
</div>
@code {
    private string _search = "";
    private StageHost? _stage;
    private string PhaseClass => Stage.Phase switch { StagePhase.Opening => "stage-opening", StagePhase.Handoff => "stage-handoff", StagePhase.Closing => "stage-closing", _ => "" };
    private bool _inReader;
    private RouteInfo _route = new();
    private LibraryCounts _counts = new(0, 0, 0, 0, 0);
    private IReadOnlyList<Shelf> _shelves = [];
    private bool _importing, _importCancelled;
    private double _importProgress;
    private CancellationTokenSource? _importCancellation;
    private readonly List<ImportResult> _importResults = [];
    private readonly MudTheme _theme = new()
    {
        PaletteDark = new() { Primary = "#EDEBE6", PrimaryContrastText = "#0B0B0C", Secondary = "#9A968E", SecondaryContrastText = "#0B0B0C", Background = "#0B0B0C", Surface = "#151517", TextPrimary = "#EDEBE6", TextSecondary = "#9A968E", DrawerBackground = "#101012", LinesDefault = "rgba(237,235,230,0.14)", ActionDefault = "#C9C5BD", AppbarBackground = "#0B0B0C" },
        PaletteLight = new() { Primary = "#1A1917", PrimaryContrastText = "#FBF9F4", Secondary = "#5E5A53", Background = "#F3F0E8", Surface = "#FBF9F4", TextPrimary = "#1A1917", TextSecondary = "#5E5A53", LinesDefault = "rgba(26,25,23,0.14)", ActionDefault = "#5E5A53", AppbarBackground = "#F3F0E8" },
        Typography = new()
        {
            Default = new DefaultTypography { FontFamily = ["Inter", "Segoe UI", "system-ui", "sans-serif"] },
            H6 = new H6Typography { FontFamily = ["Instrument Serif", "Georgia", "serif"], FontSize = "1.6rem", FontWeight = "400" },
        },
        LayoutProperties = new() { DefaultBorderRadius = "6px" }
    };

    /// <summary>The current address, parsed for the sidebar and header.</summary>
    private sealed record RouteInfo(bool Home = false, bool Shelf = false, Guid? ShelfId = null, ReadingStatus? Status = null, bool Trash = false, bool Settings = false, bool Search = false, bool Book = false, string? Query = null);
    private static RouteInfo Parse(string relative)
    {
        var parts = relative.Split('#')[0].Split('?', 2);
        var segments = parts[0].Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries);
        var query = (parts.Length > 1 ? parts[1] : "").Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(pair => pair.Split('=', 2)).GroupBy(kv => Uri.UnescapeDataString(kv[0]))
            .ToDictionary(g => g.Key, g => Uri.UnescapeDataString((g.First().ElementAtOrDefault(1) ?? "").Replace('+', ' ')));
        string? Get(string key) => query.TryGetValue(key, out var v) && v.Length > 0 ? v : null;
        ReadingStatus? status = Enum.TryParse<ReadingStatus>(Get("status"), true, out var s) ? s : null;
        return segments switch
        {
            [] => new(Home: true, Query: Get("q")),
            ["shelf"] => new(Shelf: true, Status: status, Query: Get("q")),
            ["shelf", var id] => new(Shelf: true, ShelfId: Guid.TryParse(id, out var g) ? g : null, Status: status, Query: Get("q")),
            ["trash"] => new(Trash: true, Query: Get("q")),
            ["settings"] => new(Settings: true),
            ["search"] => new(Search: true, Query: Get("q")),
            ["book", ..] => new(Book: true),
            _ => new(),
        };
    }
    private string HeaderTitle => _route switch
    {
        { Trash: true } => "Trash", { Settings: true } => "Settings", { Search: true } => "Search", { Book: true } => "Book",
        { ShelfId: { } id } => _shelves.FirstOrDefault(s => s.Id == id)?.Name ?? "Shelf",
        { Status: ReadingStatus.Reading } => "Currently reading", { Status: ReadingStatus.WantToRead } => "Want to read", { Status: ReadingStatus.Finished } => "Finished",
        _ => "Library"
    };
    private string SkipTarget => "#folio-main";
    private static string Active(bool active) => active ? "active" : "";
    private static string? Current(bool active) => active ? "page" : null;
    private void Go(string url) => Navigator.Go(url);

    protected override async Task OnInitializedAsync()
    {
        Inbox.Changed += ImportQueued;
        Navigation.LocationChanged += LocationChanged;
        Stage.Changed += StageChanged;
        UpdateRoute();
        await RefreshNavigation();
    }
    private void LocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var wasReading = _inReader;
        UpdateRoute();
        // Reading changes progress, status and recent books: refresh counts when the reader closes.
        _ = InvokeAsync(async () => { if (wasReading && !_inReader) await RefreshNavigation(); StateHasChanged(); });
    }
    private void UpdateRoute()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        _inReader = FolioRoutes.IsReader(relative);
        _route = Parse(relative);
        if (!_route.Search) _search = _route.Query ?? "";
        else _search = _route.Query ?? _search;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) { await ApplyPreferences(); await DrainImports(); } }

    // Typing filters the current library view through its address (?q=); Enter searches inside PDFs (/search).
    private void SearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        if (_route.Search) return;
        var q = string.IsNullOrWhiteSpace(_search) ? null : _search;
        var target = _route switch
        {
            { Trash: true } => q == null ? FolioRoutes.Trash : $"{FolioRoutes.Trash}?q={Uri.EscapeDataString(q)}",
            { Shelf: true } => FolioRoutes.Shelf(_route.ShelfId, _route.Status, q),
            _ => FolioRoutes.Shelf(query: q)
        };
        if (q == null && _route.Shelf && _route.ShelfId == null && _route.Status == null) target = FolioRoutes.Home;
        Navigator.Go(target, replace: true);
    }
    private void SearchKey(KeyboardEventArgs e) { if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_search)) Navigator.Go(FolioRoutes.Search(_search.Trim())); }

    public async Task RefreshNavigation() { _counts = await Library.GetCountsAsync(); _shelves = await Library.GetShelvesAsync(); StateHasChanged(); }
    /// <summary>Pages call this after changing books or shelves so counts and open views refresh.</summary>
    public async Task NotifyLibraryChangedAsync() { await RefreshNavigation(); await Events.NotifyAsync(); }
    public IReadOnlyList<Shelf> Shelves => _shelves;
    private async Task ToggleTheme() { Preferences.Save(Preferences.Current with { DarkMode = !Preferences.Current.DarkMode }); await ApplyPreferences(); }
    private async Task ToggleSidebar() { Preferences.Save(Preferences.Current with { SidebarCollapsed = !Preferences.Current.SidebarCollapsed }); await ApplyPreferences(); }
    public async Task ApplyPreferences()
    {
        var p = Preferences.Current;
        await JS.InvokeVoidAsync("folioShell.applyPreferences", new
        {
            darkMode = p.DarkMode, fontScale = p.FontScale,
            motion = p.Motion.ToString().ToLowerInvariant(),
            libraryStyle = p.LibraryStyle == LibraryStyle.TwoD ? "2d" : "3d",
        });
        if (_stage != null) await _stage.ApplyPreferencesAsync();
        StateHasChanged();
    }
    private async Task ManageShelves()
    {
        var dialog = await Dialogs.ShowAsync<ManageShelvesDialog>("Manage shelves", new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium });
        await dialog.Result;
        await NotifyLibraryChangedAsync();
        if (_route.ShelfId is { } id && _shelves.All(s => s.Id != id)) Go(FolioRoutes.Home);
    }
    private void ImportQueued() => _ = InvokeAsync(DrainImports);
    private async Task DrainImports() { if (_importing) return; while (Inbox.TryTake(out var paths)) await ImportPaths(paths!); }
    private async Task ImportFolder() { var folder = await FilePicker.PickFolderAsync(); if (folder != null) await ImportPaths([folder]); }
    private bool _creatingShelf;
    private async Task CreateShelf()
    {
        if (_creatingShelf) return;
        _creatingShelf = true;
        try
        {
            var dialog = await Dialogs.ShowAsync<CreateShelfDialog>("Create a shelf", new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
            if (await dialog.Result is { Canceled: false, Data: Shelf shelf })
            {
                await NotifyLibraryChangedAsync();
                Notifications.Add($"{shelf.Name} is ready. Add books from their menu.", Severity.Success, "Shelf created");
            }
        }
        finally { _creatingShelf = false; }
    }
    public async Task ImportBooks()
    {
        if (_importing) return;
        var paths = await FilePicker.PickPdfFilesAsync();
        await ImportPaths(paths);
    }
    private async Task ImportPaths(IReadOnlyList<string> sources)
    {
        if (sources.Count == 0) return;
        if (_importing) { Inbox.Add(sources); return; }
        _importing = true; _importCancelled = false; _importProgress = 0; _importResults.Clear(); _importCancellation = new();
        try
        {
            var paths = await Task.Run(() => ImportInbox.Expand(sources, _importCancellation.Token), _importCancellation.Token);
            if (paths.Count == 0) { Notifications.Add("No PDF files were found in the selected files or folders.", Severity.Info); return; }
            await using var scope = Scopes.CreateAsyncScope();
            var importer = scope.ServiceProvider.GetRequiredService<IBookImportService>();
            for (var index = 0; index < paths.Count; index++)
            {
                _importCancellation.Token.ThrowIfCancellationRequested();
                try { _importResults.Add(await importer.ImportFileAsync(paths[index], _importCancellation.Token)); }
                catch (OperationCanceledException) { throw; }
                catch (Exception ex) { _importResults.Add(new(false, new Book { Title = Path.GetFileNameWithoutExtension(paths[index]) }, ex.Message)); }
                _importProgress = (double)(index + 1) / paths.Count; StateHasChanged();
            }
        }
        catch (OperationCanceledException) { _importCancelled = true; Notifications.Add("Import stopped. Books already added are kept.", Severity.Info); }
        catch (Exception ex) { Notifications.Add(ex.Message, Severity.Error, "Import failed"); }
        finally { _importing = false; _importCancellation.Dispose(); _importCancellation = null; await NotifyLibraryChangedAsync(); RemindToBackUp(); StateHasChanged(); }
        await DrainImports();
    }
    /// <summary>Browser libraries can be evicted: suggest a backup after the first import and then every 30 days.</summary>
    private void RemindToBackUp()
    {
        if (!Platform.SupportsLibraryBackup || !_importResults.Any(r => r.IsNew && r.Error == null)) return;
        var last = Preferences.Current.BackupReminderAt;
        if (last != null && DateTimeOffset.UtcNow - last < TimeSpan.FromDays(30)) return;
        Preferences.Save(Preferences.Current with { BackupReminderAt = DateTimeOffset.UtcNow });
        Notifications.Add("Your books are stored in this browser, which can clear its storage. Export a backup from Settings to keep them safe.", Severity.Info, "Back up your library");
    }
    public void Dispose() { Inbox.Changed -= ImportQueued; Navigation.LocationChanged -= LocationChanged; Stage.Changed -= StageChanged; _importCancellation?.Cancel(); }
    private void StageChanged() => _ = InvokeAsync(StateHasChanged);
}
