@inherits LayoutComponentBase
@inject ISnackbar Snackbar
@inject IBookImportService BookImportService
@inject IFilePickerService FilePickerService

<MudThemeProvider Theme="_folioTheme" IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="d-flex" style="height: 100vh; width: 100vw; overflow: hidden; background-color: var(--md-sys-color-background);" data-theme="@(_isDarkMode ? "dark" : "light")">
    @if (_openedBook != null)
    {
        <Folio.UI.Pages.ReaderView Book="@_openedBook" OnBackToLibrary="@HandleCloseBook" />
    }
    else
    {
        <!-- Left Navigation Rail (72px) -->
        <nav class="folio-nav-rail">
            <div class="folio-nav-item @(_activeNav == "Library" ? "active" : "")"
                 @onclick='@(() => SetNav("Library"))'
                 title="Library">
                <MudIcon Icon="@Icons.Material.Filled.LocalLibrary" Size="Size.Medium" />
                <span>Library</span>
            </div>

            <div class="folio-nav-item @(_activeNav == "Notebook" ? "active" : "")"
                 @onclick='@(() => SetNav("Notebook"))'
                 title="Notebook">
                <MudIcon Icon="@Icons.Material.Filled.EditNote" Size="Size.Medium" />
                <span>Notebook</span>
            </div>

            <div class="folio-nav-item @(_activeNav == "Study" ? "active" : "")"
                 @onclick='@(() => SetNav("Study"))'
                 title="Study">
                <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Medium" />
                <span>Study</span>
            </div>

            <div class="folio-nav-item @(_activeNav == "Models" ? "active" : "")"
                 @onclick='@(() => SetNav("Models"))'
                 title="Local Models">
                <MudIcon Icon="@Icons.Material.Filled.Memory" Size="Size.Medium" />
                <span>Models</span>
            </div>

            <div class="mt-auto folio-nav-item @(_activeNav == "Settings" ? "active" : "")"
                 @onclick='@(() => SetNav("Settings"))'
                 title="Settings">
                <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Medium" />
                <span>Settings</span>
            </div>
        </nav>

        <!-- Main Content Area -->
        <div class="d-flex flex-column" style="flex: 1; height: 100%; overflow: hidden;">
            <!-- Top App Bar (Acrobat-inspired Dark Chrome) -->
            <header class="folio-top-app-bar">
                <div class="folio-logo">
                    <MudIcon Icon="@Icons.Material.Filled.AutoStories" Size="Size.Medium" Color="Color.Primary" />
                    <span>Folio</span>
                </div>

                <div class="d-none d-md-flex align-center gap-1 ml-4">
                    <button class="folio-action-pill">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Color="Color.Primary" />
                        <span>Add to Workspace</span>
                    </button>

                    <div style="width: 1px; height: 20px; background-color: #383838;" class="mx-2"></div>

                    <button class="folio-action-pill @(_activeNav == "Library" ? "active" : "")" @onclick='@(() => SetNav("Library"))'>
                        Library
                    </button>
                    <button class="folio-action-pill @(_activeNav == "Notebook" ? "active" : "")" @onclick='@(() => SetNav("Notebook"))'>
                        Notes
                    </button>
                    <button class="folio-action-pill @(_activeNav == "Study" ? "active" : "")" @onclick='@(() => SetNav("Study"))'>
                        Study
                    </button>

                    <div style="width: 1px; height: 20px; background-color: #383838;" class="mx-2"></div>

                    <MudIconButton Icon="@Icons.Material.Filled.Undo"
                                   Size="Size.Small"
                                   Style="color: #A0A0A0;"
                                   title="Undo (Ctrl+Z)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Redo"
                                   Size="Size.Small"
                                   Style="color: #A0A0A0;"
                                   title="Redo (Ctrl+Y)" />
                </div>

                <!-- Global Search Bar -->
                <div class="folio-search-bar ml-auto">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Style="color: #8E8E8E;" />
                    <input class="folio-search-input"
                           type="text"
                           placeholder="Search books, notes, authors... (Ctrl+K)"
                           @bind="_searchQuery"
                           @bind:event="oninput" />
                </div>

                <div class="d-flex align-center gap-2">
                    <Folio.UI.Components.ActivityMonitorPopover />

                    <button class="folio-primary-btn" @onclick="@OpenImportDialog">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                        <span>Add books</span>
                    </button>

                    <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                                   Color="Color.Default"
                                   OnClick="@ToggleDarkMode"
                                   aria-label="Toggle dark mode" />
                </div>
            </header>

            <!-- View Body -->
            <main style="flex: 1; height: calc(100vh - 56px); overflow: hidden;">
                @if (_activeNav == "Library")
                {
                    <Folio.UI.Pages.LibraryView @ref="_libraryView" SearchQuery="@_searchQuery" OnOpenBook="@HandleOpenBook" />
                }
                else
                {
                    <div class="d-flex flex-column align-center justify-center" style="height: 100%;">
                        <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Size="Size.Large" Color="Color.Secondary" />
                        <MudText Typo="Typo.h6" Class="mt-2" Color="Color.Secondary">
                            @_activeNav view will arrive in the upcoming milestone.
                        </MudText>
                    </div>
                }
            </main>
        </div>
    }
</div>

@code {
    private string _activeNav = "Library";
    private string _searchQuery = "";
    private bool _isDarkMode = true; // Default to sleek dark mode
    private Folio.UI.Pages.LibraryView? _libraryView;
    private Folio.Domain.Entities.Book? _openedBook;

    private void HandleOpenBook(Folio.Domain.Entities.Book book)
    {
        _openedBook = book;
        StateHasChanged();
    }

    private async Task HandleCloseBook()
    {
        _openedBook = null;
        if (_libraryView != null)
        {
            await _libraryView.RefreshAsync();
        }
        StateHasChanged();
    }

    private readonly MudTheme _folioTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1473E6",
            PrimaryDarken = "#0D66D0",
            PrimaryLighten = "#4098FF",
            Secondary = "#5C6BC0",
            Background = "#F4F4F4",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            DrawerBackground = "#FAFAFA",
            TextPrimary = "#181818",
            TextSecondary = "#616161",
            ActionDefault = "#616161",
            LinesDefault = "#E0E0E0"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#1473E6",
            PrimaryDarken = "#0D66D0",
            PrimaryLighten = "#4098FF",
            Secondary = "#8C9EFF",
            Background = "#141414",
            Surface = "#1A1A1A",
            AppbarBackground = "#1A1A1A",
            DrawerBackground = "#181818",
            TextPrimary = "#FFFFFF",
            TextSecondary = "#B3B3B3",
            ActionDefault = "#CCCCCC",
            LinesDefault = "#333333"
        }
    };

    private void SetNav(string nav)
    {
        _activeNav = nav;
    }

    private void ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
    }

    private async Task OpenImportDialog()
    {
        var fileNames = await FilePickerService.PickPdfFilesAsync();

        if (fileNames.Count > 0)
        {
            Snackbar.Add($"Importing {fileNames.Count} book(s)...", Severity.Info);
            var results = await BookImportService.ImportFilesAsync(fileNames);

            int newCount = results.Count(r => r.IsNew);
            int existingCount = results.Count(r => !r.IsNew && r.Error == null);

            if (newCount > 0)
            {
                Snackbar.Add($"Successfully imported {newCount} new book(s)!", Severity.Success);
            }
            if (existingCount > 0)
            {
                Snackbar.Add($"{existingCount} book(s) were already in your library.", Severity.Normal);
            }

            if (_libraryView != null)
            {
                await _libraryView.RefreshAsync();
            }
        }
    }
}
