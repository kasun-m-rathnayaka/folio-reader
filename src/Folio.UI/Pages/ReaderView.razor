@using System.Timers
@using Folio.Application.Reading
@using Folio.Application.Reading.DTOs
@using Folio.Application.Annotations
@using Folio.Application.Annotations.DTOs
@using Folio.Application.Audio
@using Folio.Domain.Audio
@using Folio.Domain.Entities
@using Folio.Domain.Enums
@using Folio.Domain.Geometry
@using Folio.Domain.Theme
@using Folio.UI.Components
@using Folio.UI.Services
@inject ReaderJsBridge ReaderBridge
@inject IReadingPositionService ReadingPositionService
@inject IBookmarkService BookmarkService
@inject IAnnotationService AnnotationService
@inject IAnnotationExportService ExportService
@inject IAudioPlaybackService AudioService
@inject ISentenceSegmenter SentenceSegmenter
@inject ITextNormalizer TextNormalizer
@inject ILayoutBlockClassifier BlockClassifier
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="d-flex flex-column @(_isZenMode ? "folio-zen-active" : "")"
     style="height: 100%; width: 100%; position: relative; overflow: hidden; background-color: var(--md-sys-color-background);"
     tabindex="0"
     @onkeydown="HandleKeyDown">

    <!-- Top Reader Toolbar -->
    <ReaderToolbar Title="@Book.Title"
                   CurrentPage="@(_currentPageIndex + 1)"
                   TotalPages="@Math.Max(1, _totalPages)"
                   Zoom="@_zoom"
                   LayoutMode="@_layoutMode"
                   IsOutlineOpen="@_isOutlineOpen"
                   IsSearchOpen="@_isSearchOpen"
                   IsZenMode="@_isZenMode"
                   IsDogEared="@_isDogEared"
                   IsNotesOpen="@_isNotesOpen"
                   IsAudioPlaying="@AudioService.IsPlaying"
                   OnBack="@HandleBack"
                   OnToggleOutline="@ToggleOutline"
                   OnToggleDogEar="@ToggleDogEarAsync"
                   OnToggleNotes="@ToggleNotes"
                   OnToggleAudio="@ToggleReadAloudAsync"
                   OnOpenNotebook="@OpenNotebookAsync"
                   OnPrevPage="@HandlePrevPage"
                   OnNextPage="@HandleNextPage"
                   OnOpenGoToPage="@OpenGoToPageDialog"
                   OnZoomIn="@HandleZoomIn"
                   OnZoomOut="@HandleZoomOut"
                   OnFitWidth="@HandleFitWidth"
                   OnFitPage="@HandleFitPage"
                   OnToggleLayoutMode="@ToggleLayoutMode"
                   OnRotateClockwise="@RotateClockwise"
                   OnToggleSearch="@ToggleSearch"
                   OnToggleZenMode="@ToggleZenMode" />

    <!-- In-Book Search Floating Bar -->
    @if (_isSearchOpen)
    {
        <FindInBookBar Query="@_searchQuery"
                       CurrentMatch="@_currentSearchMatch"
                       TotalMatches="@_totalSearchMatches"
                       OnQueryChanged="@HandleSearchQueryChanged"
                       OnFindNext="@HandleFindNext"
                       OnFindPrevious="@HandleFindPrevious"
                       OnClose="@(() => _isSearchOpen = false)" />
    }

    <!-- Main Reader Workspace -->
    <div class="d-flex" style="flex: 1; height: calc(100% - 48px); width: 100%; overflow: hidden; position: relative;">
        <!-- Collapsible Inspector / Edit & Tools Panel (Matches screenshot) -->
        @if (_isOutlineOpen)
        {
            <InspectorPanel Outline="@_outline"
                            CurrentPageIndex="@_currentPageIndex"
                            LayoutMode="@_layoutMode"
                            ThemeSettings="@_themeSettings"
                            OnSelectPage="@HandleSelectOutlinePage"
                            OnRotate="@RotateDegrees"
                            OnFitWidth="@HandleFitWidth"
                            OnFitPage="@HandleFitPage"
                            OnToggleLayout="@ToggleLayoutMode"
                            OnThemeSettingsChanged="@HandleThemeSettingsChanged"
                            OnClose="@ToggleOutline" />
        }

        <!-- PDF.js Canvas & TextLayer Host Container -->
        <div id="folio-pdf-container" style="flex: 1; height: 100%; width: 100%; position: relative;">
            <!-- Floating Vertical Tool Rail (Matches screenshot pill) -->
            <FloatingToolRail ActiveTool="@_activeTool"
                              OnToolChanged="@HandleToolChanged"
                              OnMoreOptions="@OpenCommandPaletteAsync" />

            <!-- Floating Selection Quick Bar (FR-ANN-01) -->
            <SelectionQuickBar IsVisible="@_isSelectionBarVisible"
                               ClientX="@_selectionClientX"
                               ClientY="@_selectionClientY"
                               OnApplyHighlight="@HandleApplyHighlight"
                               OnAddNote="@HandleAddNoteFromSelection"
                               OnCopyQuote="@HandleCopyQuoteFromSelection"
                               OnDismiss="@HandleDismissSelection" />

            <!-- Floating Audio Narration Player Bar (FR-TTS-01..05) -->
            <AudioPlayerBar IsVisible="@_isAudioBarVisible"
                            OnStop="@HandleStopAudio" />

            <!-- Multi-Layer Physical Book & Lighting Stack (FR-FEL-01..03, §6.4) -->
            <div class="folio-lighting-warmth" style="opacity: @(_themeSettings.WarmthAlpha.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture));"></div>
            <div class="folio-lighting-dim" style="opacity: @(_themeSettings.DimAlpha.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture));"></div>
            @if (_themeSettings.EnableVignette)
            {
                <div class="folio-lighting-vignette" style="opacity: 0.75;"></div>
            }
            @if (_themeSettings.EnableRuler)
            {
                <div id="folio-active-focus-ruler" class="folio-focus-ruler" style="display: block;"></div>
            }

            <div class="folio-reader-loading">
                Initializing reader...
            </div>
        </div>

        <!-- Marginalia Lane (FR-ANN-02) -->
        @if (_isNotesOpen)
        {
            <MarginaliaLane Annotations="@_pageAnnotations"
                            ActiveAnnotationId="@_activeAnnotationId"
                            OnSelectAnnotation="@HandleSelectAnnotationCard"
                            OnDeleteAnnotation="@HandleDeleteAnnotation"
                            OnSaveNote="@HandleSaveNote"
                            OnClose="@(() => _isNotesOpen = false)" />
        }
    </div>
</div>

@code {
    [Parameter] public Book Book { get; set; } = default!;
    [Parameter] public EventCallback OnBackToLibrary { get; set; }

    private DotNetObjectReference<ReaderView>? _dotNetRef;
    private int _currentPageIndex = 0;
    private int _totalPages = 1;
    private double _zoom = 1.0;
    private double _currentOffsetPercent = 0.0;
    private ReaderViewMode _layoutMode = ReaderViewMode.Continuous;

    private bool _isOutlineOpen = false;
    private bool _isSearchOpen = false;
    private bool _isZenMode = false;
    private bool _hasInitializedViewer = false;

    private bool _isDogEared = false;
    private bool _isNotesOpen = false;
    private List<AnnotationDto> _pageAnnotations = new();
    private Guid? _activeAnnotationId;
    private ThemeSettings _themeSettings = ThemeSettings.Default;

    private bool _isSelectionBarVisible = false;
    private double _selectionClientX = 300;
    private double _selectionClientY = 150;
    private string? _selectedText;
    private IReadOnlyList<NormalizedRect> _selectedRects = Array.Empty<NormalizedRect>();

    private string _searchQuery = "";
    private int _currentSearchMatch = 0;
    private int _totalSearchMatches = 0;
    private List<OutlineNodeDto> _outline = new();
    private string _activeTool = "select";
    private bool _isAudioBarVisible = false;

    // Telemetry and session active reading tracker (FR-MEM-01..04)
    private DateTimeOffset _lastInteractionTime = DateTimeOffset.UtcNow;
    private long _accumulatedActiveSeconds = 0;
    private Timer? _activeTimer;
    private Timer? _debounceAutosaveTimer;

    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);

        // Audio follow-along listener
        AudioService.SentenceStarted += OnAudioSentenceStarted;
        AudioService.PlaybackEnded += OnAudioPlaybackEnded;

        // 1-second interval timer for tracking active reading time (FR-MEM-04)
        _activeTimer = new Timer(1000);
        _activeTimer.Elapsed += OnActiveTimerTick;
        _activeTimer.AutoReset = true;
        _activeTimer.Start();

        // 2-second debounce timer for position persistence
        _debounceAutosaveTimer = new Timer(2000);
        _debounceAutosaveTimer.Elapsed += OnDebounceTimerElapsed;
        _debounceAutosaveTimer.AutoReset = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasInitializedViewer)
        {
            _hasInitializedViewer = true;

            // Load saved reading position from SQLite
            var savedPos = await ReadingPositionService.GetPositionAsync(Book.Id);
            if (savedPos != null)
            {
                _currentPageIndex = savedPos.PageIndex;
                _currentOffsetPercent = savedPos.OffsetPercent;
                _zoom = savedPos.Zoom > 0 ? savedPos.Zoom : 1.0;
                _layoutMode = savedPos.ViewMode;
            }

            // Initialize JavaScript PDF engine
            await ReaderBridge.InitAsync("folio-pdf-container", _dotNetRef!);

            string pdfUrl = $"https://folio.books/{Book.Sha256}.pdf";
            string layoutModeStr = _layoutMode == ReaderViewMode.SinglePage ? "single" : "continuous";

            await ReaderBridge.LoadDocumentAsync(
                pdfUrl,
                _currentPageIndex,
                _currentOffsetPercent,
                _zoom,
                layoutModeStr);

            // Display resume toast if resumed past page 1 (FR-MEM-02)
            if (_currentPageIndex > 0)
            {
                Snackbar.Add($"Resumed at page {_currentPageIndex + 1}", Severity.Info, config =>
                {
                    config.Action = "Start from beginning";
                    config.ActionColor = Color.Primary;
                    config.OnClick = _ => HandleGoToPage(0);
                });
            }
        }
    }

    private void RecordActivity()
    {
        _lastInteractionTime = DateTimeOffset.UtcNow;
    }

    private void OnActiveTimerTick(object? sender, ElapsedEventArgs e)
    {
        // Pause timer if user is idle for more than 2 minutes (FR-MEM-04)
        if (DateTimeOffset.UtcNow - _lastInteractionTime <= TimeSpan.FromMinutes(2))
        {
            _accumulatedActiveSeconds++;
        }
    }

    private async void OnDebounceTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        await PersistPositionAsync();
    }

    private async Task PersistPositionAsync()
    {
        try
        {
            await ReadingPositionService.SavePositionAsync(
                Book.Id,
                _currentPageIndex,
                _currentOffsetPercent,
                _zoom,
                _layoutMode,
                _accumulatedActiveSeconds);
            _accumulatedActiveSeconds = 0;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Failed to persist reading position: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task OnDocumentLoaded(DocumentLoadedPayload payload)
    {
        _totalPages = payload.TotalPages > 0 ? payload.TotalPages : Book.PageCount;
        _outline = payload.Outline ?? new List<OutlineNodeDto>();
        await LoadPageAnnotationsAndBookmarksAsync(_currentPageIndex);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnPositionChanged(PositionPayload payload)
    {
        RecordActivity();
        int prevPage = _currentPageIndex;
        _currentPageIndex = payload.PageIndex;
        _currentOffsetPercent = payload.OffsetPercent;
        if (payload.Zoom > 0)
        {
            _zoom = payload.Zoom;
        }

        if (prevPage != _currentPageIndex)
        {
            await LoadPageAnnotationsAndBookmarksAsync(_currentPageIndex);
        }

        // Trigger 2s debounced auto-save
        _debounceAutosaveTimer?.Stop();
        _debounceAutosaveTimer?.Start();

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnTextSelected(TextSelectionDto payload)
    {
        RecordActivity();
        _selectedText = payload.SelectedText;
        _selectedRects = payload.Rects;
        _isSelectionBarVisible = true;
        _selectionClientX = 350;
        _selectionClientY = 160;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnSnipCompleted(SnipPayload payload)
    {
        RecordActivity();
        var ann = await AnnotationService.CreateAnnotationAsync(new CreateAnnotationDto(
            BookId: Book.Id,
            PageIndex: payload.PageIndex,
            Type: AnnotationType.AreaSnip,
            Color: HighlightColor.Blue,
            Rects: new[] { payload.Rect },
            Note: "Area Snip"
        ));
        _pageAnnotations.Add(ann);
        await RedrawPageAnnotationsAsync();
        _isNotesOpen = true;
        Snackbar.Add("Area snip captured", Severity.Success);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnDogEarToggled(int pageIndex)
    {
        RecordActivity();
        var result = await BookmarkService.ToggleDogEarAsync(Book.Id, pageIndex);
        _isDogEared = result != null;
        await ReaderBridge.SetDogEarAsync(pageIndex, _isDogEared);
        Snackbar.Add(_isDogEared ? $"Page {pageIndex + 1} dog-eared" : $"Page {pageIndex + 1} dog-ear removed", Severity.Info);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnAnnotationClicked(string annId)
    {
        RecordActivity();
        if (Guid.TryParse(annId, out var id))
        {
            _activeAnnotationId = id;
            _isNotesOpen = true;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadPageAnnotationsAndBookmarksAsync(int pageIndex)
    {
        _isDogEared = await BookmarkService.IsPageDogEaredAsync(Book.Id, pageIndex);
        var annotations = await AnnotationService.GetAnnotationsForPageAsync(Book.Id, pageIndex);
        _pageAnnotations = annotations.ToList();
        await RedrawPageAnnotationsAsync();
        await ReaderBridge.SetDogEarAsync(pageIndex, _isDogEared);
    }

    private async Task RedrawPageAnnotationsAsync()
    {
        var rawList = _pageAnnotations.Select(a => new
        {
            id = a.Id.ToString(),
            type = a.Type.ToString(),
            colorHex = a.Color.ToHex(),
            rects = a.Rects
        }).ToList();
        await ReaderBridge.DrawAnnotationsAsync(_currentPageIndex, rawList);
    }

    private async Task ToggleDogEarAsync()
    {
        await OnDogEarToggled(_currentPageIndex);
    }

    private void ToggleNotes()
    {
        _isNotesOpen = !_isNotesOpen;
    }

    private async Task OpenNotebookAsync()
    {
        var parameters = new DialogParameters<NotebookView>
        {
            { x => x.BookId, Book.Id },
            { x => x.BookTitle, Book.Title },
            { x => x.Author, Book.Author },
            { x => x.OnJumpToPage, EventCallback.Factory.Create<int>(this, HandleGoToPage) }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large };
        await DialogService.ShowAsync<NotebookView>("Notebook", parameters, options);
    }

    private async Task HandleSelectAnnotationCard(Guid annId)
    {
        _activeAnnotationId = annId;
        await ReaderBridge.PulseAnnotationAsync(annId);
    }

    private async Task HandleDeleteAnnotation(Guid annId)
    {
        await AnnotationService.DeleteAnnotationAsync(annId);
        _pageAnnotations.RemoveAll(a => a.Id == annId);
        await RedrawPageAnnotationsAsync();
        Snackbar.Add("Annotation deleted", Severity.Info);
    }

    private async Task HandleSaveNote((Guid Id, string Note) data)
    {
        await AnnotationService.UpdateAnnotationAsync(new UpdateAnnotationDto(data.Id, Note: data.Note));
        var idx = _pageAnnotations.FindIndex(a => a.Id == data.Id);
        if (idx >= 0)
        {
            var old = _pageAnnotations[idx];
            _pageAnnotations[idx] = old with { Note = data.Note };
        }
        Snackbar.Add("Note updated", Severity.Success);
    }

    private async Task HandleApplyHighlight((HighlightColor Color, AnnotationType Type) option)
    {
        if (string.IsNullOrEmpty(_selectedText) || _selectedRects.Count == 0) return;

        var ann = await AnnotationService.CreateAnnotationAsync(new CreateAnnotationDto(
            BookId: Book.Id,
            PageIndex: _currentPageIndex,
            Type: option.Type,
            Color: option.Color,
            Rects: _selectedRects,
            SelectedText: _selectedText
        ));

        _pageAnnotations.Add(ann);
        await RedrawPageAnnotationsAsync();
        _isSelectionBarVisible = false;
        await ReaderBridge.ClearSelectionBoxAsync();
        Snackbar.Add($"{option.Type} created", Severity.Success);
    }

    private async Task HandleAddNoteFromSelection()
    {
        if (string.IsNullOrEmpty(_selectedText) || _selectedRects.Count == 0) return;

        var ann = await AnnotationService.CreateAnnotationAsync(new CreateAnnotationDto(
            BookId: Book.Id,
            PageIndex: _currentPageIndex,
            Type: AnnotationType.MarginNote,
            Color: HighlightColor.Yellow,
            Rects: _selectedRects,
            SelectedText: _selectedText,
            Note: "Note added from selection"
        ));

        _pageAnnotations.Add(ann);
        await RedrawPageAnnotationsAsync();
        _activeAnnotationId = ann.Id;
        _isNotesOpen = true;
        _isSelectionBarVisible = false;
        await ReaderBridge.ClearSelectionBoxAsync();
    }

    private async Task HandleCopyQuoteFromSelection()
    {
        if (!string.IsNullOrEmpty(_selectedText))
        {
            string citation = ExportService.FormatQuoteCitation(_selectedText, Book.Title, Book.Author, _currentPageIndex);
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", citation);
            Snackbar.Add("Quote citation copied to clipboard", Severity.Success);
        }
        _isSelectionBarVisible = false;
        await ReaderBridge.ClearSelectionBoxAsync();
    }

    private async Task HandleDismissSelection()
    {
        _isSelectionBarVisible = false;
        await ReaderBridge.ClearSelectionBoxAsync();
    }

    [JSInvokable]
    public void OnSearchMatch(SearchMatchPayload payload)
    {
        RecordActivity();
        _currentSearchMatch = payload.CurrentMatch;
        _totalSearchMatches = payload.TotalMatches;
        _currentPageIndex = payload.PageIndex;
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleBack()
    {
        await PersistPositionAsync();
        if (OnBackToLibrary.HasDelegate)
        {
            await OnBackToLibrary.InvokeAsync();
        }
    }

    private async Task HandlePrevPage()
    {
        RecordActivity();
        if (_currentPageIndex > 0)
        {
            await HandleGoToPage(_currentPageIndex - 1);
        }
    }

    private async Task HandleNextPage()
    {
        RecordActivity();
        if (_currentPageIndex < _totalPages - 1)
        {
            await HandleGoToPage(_currentPageIndex + 1);
        }
    }

    private async Task HandleGoToPage(int pageIndex)
    {
        RecordActivity();
        _currentPageIndex = Math.Clamp(pageIndex, 0, _totalPages - 1);
        await ReaderBridge.GoToPageAsync(_currentPageIndex, 0.0);
        StateHasChanged();
    }

    private async Task HandleThemeSettingsChanged(ThemeSettings settings)
    {
        RecordActivity();
        _themeSettings = settings;
        await ReaderBridge.ApplyThemeAsync(new
        {
            backgroundHex = settings.Theme.GetBackgroundHex(),
            inkHex = settings.Theme.GetInkHex(),
            cssFilter = settings.Theme.GetCssFilter(),
            warmthAlpha = settings.WarmthAlpha,
            dimAlpha = settings.DimAlpha,
            vignetteOpacity = settings.EnableVignette ? 0.75 : 0.0
        });

        await ReaderBridge.SetFocusRulerAsync(settings.EnableRuler, settings.FocusLines > 0 ? settings.FocusLines : 1);
        StateHasChanged();
    }

    private async Task OpenGoToPageDialog()
    {
        RecordActivity();
        var parameters = new DialogParameters<GoToPageDialog>
        {
            { x => x.CurrentPage, _currentPageIndex + 1 },
            { x => x.TotalPages, _totalPages }
        };

        var dialog = await DialogService.ShowAsync<GoToPageDialog>("Go to Page", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is int targetPage)
        {
            await HandleGoToPage(targetPage - 1);
        }
    }

    private async Task HandleZoomIn()
    {
        RecordActivity();
        double current = _zoom > 0 ? _zoom : 1.0;
        _zoom = Math.Min(4.0, Math.Round(current + 0.25, 2));
        await ReaderBridge.SetZoomAsync(_zoom);
    }

    private async Task HandleZoomOut()
    {
        RecordActivity();
        double current = _zoom > 0 ? _zoom : 1.0;
        _zoom = Math.Max(0.25, Math.Round(current - 0.25, 2));
        await ReaderBridge.SetZoomAsync(_zoom);
    }

    private async Task HandleFitWidth()
    {
        RecordActivity();
        _zoom = -1;
        await ReaderBridge.SetFitWidthAsync();
    }

    private async Task HandleFitPage()
    {
        RecordActivity();
        _zoom = -2;
        await ReaderBridge.SetFitPageAsync();
    }

    private async Task ToggleLayoutMode()
    {
        RecordActivity();
        _layoutMode = _layoutMode == ReaderViewMode.Continuous
            ? ReaderViewMode.SinglePage
            : ReaderViewMode.Continuous;

        string mode = _layoutMode == ReaderViewMode.SinglePage ? "single" : "continuous";
        await ReaderBridge.SetLayoutModeAsync(mode);
    }

    private async Task RotateClockwise()
    {
        RecordActivity();
        await ReaderBridge.SetRotationAsync(90);
    }

    private async Task HandleToolChanged(string tool)
    {
        RecordActivity();
        _activeTool = tool;
        if (tool == "snip")
        {
            await ReaderBridge.SetSnipModeAsync(true);
            Snackbar.Add("Drag a rectangle on the page to snip an area", Severity.Info);
        }
        else if (tool == "note")
        {
            _isNotesOpen = true;
        }
        else if (tool == "highlight")
        {
            if (!string.IsNullOrEmpty(_selectedText))
            {
                await HandleApplyHighlight((HighlightColor.Yellow, AnnotationType.Highlight));
            }
        }
        else if (tool == "audio")
        {
            await ToggleReadAloudAsync();
        }
        else
        {
            await ReaderBridge.SetSnipModeAsync(false);
        }
    }

    private async Task RotateDegrees(int delta)
    {
        RecordActivity();
        await ReaderBridge.SetRotationAsync(delta);
    }

    private void ToggleOutline()
    {
        RecordActivity();
        _isOutlineOpen = !_isOutlineOpen;
    }

    private void ToggleSearch()
    {
        RecordActivity();
        _isSearchOpen = !_isSearchOpen;
        if (!_isSearchOpen)
        {
            _searchQuery = "";
            _ = ReaderBridge.ClearSearchAsync();
        }
    }

    private void ToggleZenMode()
    {
        RecordActivity();
        _isZenMode = !_isZenMode;
    }

    private async Task HandleSelectOutlinePage(int pageIndex)
    {
        await HandleGoToPage(pageIndex);
    }

    private async Task HandleSearchQueryChanged(string query)
    {
        RecordActivity();
        _searchQuery = query;
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            await ReaderBridge.SearchAsync(_searchQuery, forward: true);
        }
        else
        {
            _currentSearchMatch = 0;
            _totalSearchMatches = 0;
            await ReaderBridge.ClearSearchAsync();
        }
    }

    private async Task HandleFindNext()
    {
        RecordActivity();
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            await ReaderBridge.SearchAsync(_searchQuery, forward: true);
        }
    }

    private async Task HandleFindPrevious()
    {
        RecordActivity();
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            await ReaderBridge.SearchAsync(_searchQuery, forward: false);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        RecordActivity();

        if (e.CtrlKey && e.Key.Equals("g", StringComparison.OrdinalIgnoreCase))
        {
            await OpenGoToPageDialog();
        }
        else if (e.CtrlKey && e.Key.Equals("d", StringComparison.OrdinalIgnoreCase))
        {
            await ToggleDogEarAsync();
        }
        else if (e.CtrlKey && e.Key.Equals("f", StringComparison.OrdinalIgnoreCase))
        {
            ToggleSearch();
        }
        else if (e.CtrlKey && e.Key.Equals("k", StringComparison.OrdinalIgnoreCase))
        {
            await OpenCommandPaletteAsync();
        }
        else if (e.Key.Equals("h", StringComparison.OrdinalIgnoreCase) && !e.CtrlKey && !e.AltKey && !string.IsNullOrEmpty(_selectedText))
        {
            await HandleApplyHighlight((HighlightColor.Yellow, AnnotationType.Highlight));
        }
        else if (e.Key.Equals("c", StringComparison.OrdinalIgnoreCase) && !e.CtrlKey && !e.AltKey && !string.IsNullOrEmpty(_selectedText))
        {
            await HandleAddNoteFromSelection();
        }
        else if (e.Key == "F11")
        {
            ToggleZenMode();
        }
        else if (e.Key == "Escape")
        {
            if (_isSearchOpen)
            {
                ToggleSearch();
            }
            else if (_isOutlineOpen)
            {
                ToggleOutline();
            }
            else if (_isZenMode)
            {
                ToggleZenMode();
            }
            else
            {
                await HandleBack();
            }
        }
    }

    private async Task OpenCommandPaletteAsync()
    {
        var dialog = await DialogService.ShowAsync<CommandPalette>("Command Palette");
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is string action)
        {
            switch (action)
            {
                case "goto": await OpenGoToPageDialog(); break;
                case "find": ToggleSearch(); break;
                case "fitwidth": await HandleFitWidth(); break;
                case "fitpage": await HandleFitPage(); break;
                case "zoomin": await HandleZoomIn(); break;
                case "zoomout": await HandleZoomOut(); break;
                case "rotate": await RotateClockwise(); break;
                case "layout": await ToggleLayoutMode(); break;
                case "toc": ToggleOutline(); break;
                case "notebook": await OpenNotebookAsync(); break;
                case "zen": ToggleZenMode(); break;
                case "audio": await ToggleReadAloudAsync(); break;
                case "back": await HandleBack(); break;
            }
        }
    }

    private async Task ToggleReadAloudAsync()
    {
        RecordActivity();
        if (AudioService.IsPlaying)
        {
            await AudioService.StopAsync();
            _isAudioBarVisible = false;
            await ReaderBridge.ClearOverlaysAsync(_currentPageIndex);
        }
        else
        {
            _isAudioBarVisible = true;
            await StartNarrationAsync(_currentPageIndex);
        }
    }

    private async Task StartNarrationAsync(int pageIndex)
    {
        var pageTextData = await ReaderBridge.GetPageTextAsync(pageIndex);
        var sentences = new List<SentenceSpoken>();

        if (pageTextData != null && !string.IsNullOrWhiteSpace(pageTextData.Text))
        {
            var fallbackRects = pageTextData.Items.Select(i => i.Rect).ToList();
            var segmented = SentenceSegmenter.Segment(pageTextData.Text, pageIndex, fallbackRects, BlockClassifier, TextNormalizer);
            sentences.AddRange(segmented);
        }

        if (sentences.Count == 0)
        {
            sentences.Add(new SentenceSpoken
            {
                PageIndex = pageIndex,
                OriginalText = $"Page {pageIndex + 1} has no readable text content.",
                SpokenText = $"Page {pageIndex + 1} has no readable text content.",
                Rects = Array.Empty<NormalizedRect>(),
                Kind = TextBlockKind.Paragraph,
                ShouldSkip = false,
                EstimatedDurationSeconds = 2.0
            });
        }

        await AudioService.PlayAsync(sentences, 0);
    }

    private void OnAudioSentenceStarted(SentenceSpoken sentence)
    {
        _ = InvokeAsync(async () =>
        {
            if (_currentPageIndex != sentence.PageIndex)
            {
                await HandleGoToPage(sentence.PageIndex);
            }
            if (sentence.Rects.Count > 0)
            {
                await ReaderBridge.DrawOverlaysAsync(sentence.PageIndex, sentence.Rects, "#64B5F6");
            }
            StateHasChanged();
        });
    }

    private void OnAudioPlaybackEnded()
    {
        _ = InvokeAsync(async () =>
        {
            await ReaderBridge.ClearOverlaysAsync(_currentPageIndex);
            _isAudioBarVisible = false;
            StateHasChanged();
        });
    }

    private async Task HandleStopAudio()
    {
        await AudioService.StopAsync();
        await ReaderBridge.ClearOverlaysAsync(_currentPageIndex);
        _isAudioBarVisible = false;
    }

    public async ValueTask DisposeAsync()
    {
        AudioService.SentenceStarted -= OnAudioSentenceStarted;
        AudioService.PlaybackEnded -= OnAudioPlaybackEnded;
        await AudioService.StopAsync();

        _activeTimer?.Stop();
        _activeTimer?.Dispose();
        _debounceAutosaveTimer?.Stop();
        _debounceAutosaveTimer?.Dispose();

        await PersistPositionAsync();

        if (_dotNetRef != null)
        {
            _dotNetRef.Dispose();
            _dotNetRef = null;
        }

        await ReaderBridge.DisposeAsync();
    }

    public class DocumentLoadedPayload
    {
        public int TotalPages { get; set; }
        public List<OutlineNodeDto>? Outline { get; set; }
    }

    public class PositionPayload
    {
        public int PageIndex { get; set; }
        public double OffsetPercent { get; set; }
        public double Zoom { get; set; }
    }

    public class SearchMatchPayload
    {
        public int CurrentMatch { get; set; }
        public int TotalMatches { get; set; }
        public int PageIndex { get; set; }
    }

    public class SnipPayload
    {
        public int PageIndex { get; set; }
        public NormalizedRect Rect { get; set; }
    }
}

