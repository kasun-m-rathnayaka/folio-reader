@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@using Folio.Application.Reading
@using Folio.Application.Reading.DTOs
@using Folio.Application.Annotations
@using Folio.Application.Annotations.DTOs
@using Folio.UI.Services
@using Folio.Domain.Geometry
@inject ReaderJsBridge Reader
@inject IServiceScopeFactory Scopes
@inject IReadingSessionLifetime Session
@inject ILibraryService Library
@inject IFilePickerService FilePicker
@inject IExternalLinkService Links
@inject IAppPreferencesService Preferences
@inject IDialogService Dialogs
@inject NotificationService Notifications
@inject IJSRuntime JS
@inject IBookUrlResolver Urls
@inject IPlatformCapabilities Platform
@inject Folio.UI.Stage.StageState Stage
@inject ILogger<ReaderView> Logger
@implements IAsyncDisposable

<div class="folio-reader @(_zen ? "folio-zen-active" : "")">
    <ReaderToolbar Title="@Book.Title" CurrentPage="@(_page + 1)" TotalPages="@Math.Max(1, _pages)" Zoom="@_zoom" LayoutMode="@_mode"
        IsOutlineOpen="@_contents" IsSearchOpen="@_find" IsZenMode="@_zen" IsDogEared="@_bookmarked"
        OnBack="Back" OnToggleOutline="() => _contents = !_contents" OnToggleDogEar="() => ToggleBookmark(_page)"
        OnPrevPage="() => GoTo(_page - 1)" OnNextPage="() => GoTo(_page + 1)" OnOpenGoToPage="GoToDialog"
        OnZoomIn="() => ZoomBy(.25)" OnZoomOut="() => ZoomBy(-.25)" OnFitWidth="FitWidth" OnFitPage="FitPage" OnToggleLayoutMode="ToggleLayout"
        OnRotateClockwise="() => Reader.SetRotationAsync(90).AsTask()" OnToggleSearch="ToggleFind" OnToggleZenMode="() => _zen = !_zen" />
    @if (_find) { <FindInBookBar Query="@_query" CurrentMatch="@_match" TotalMatches="@_matches" OnQueryChanged="q => Find(q)" OnFindNext="() => Find(_query)" OnFindPrevious="() => Find(_query, false)" OnClose="ToggleFind" /> }
    <div class="folio-reader-workspace">
        @if (_contents) { <ReaderSidebar Outline="@_outline" Bookmarks="@_bookmarks" CurrentPage="@_page" TotalPages="@_pages" OnSelectPage="GoTo" OnClose="() => _contents = false" OnAddBookmark="NamedBookmark" OnDeleteBookmark="DeleteBookmark" /> }
        <div class="folio-reader-viewport">
            <div id="folio-pdf-container"></div>
            @if (!_loaded || _error != null)
            {
                <div class="folio-reader-state" aria-live="polite">
                    @if (_error != null)
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.Description" Size="Size.Large" /><h2>@(_passwordRequired ? "This PDF is password protected" : "We couldn’t open this book")</h2><p>@_error</p>
                        @if (_passwordRequired) { <input class="folio-input-field" type="password" aria-label="PDF password" placeholder="Password" @bind="_password" /> }
                        <div class="d-flex gap-2"><button class="folio-primary-btn" @onclick="Retry">@(_passwordRequired ? "Unlock PDF" : "Try again")</button>@if (Platform.CanRelinkBooks) { <button class="folio-subtle-btn" @onclick="Locate">Locate PDF</button> }<button class="folio-subtle-btn" @onclick="Back">Back to library</button></div>
                    }
                    else { <MudProgressCircular Indeterminate="true" Size="Size.Small" aria-label="Opening your book" /><p>Opening your book…</p> }
                </div>
            }
        </div>
    </div>
    <SelectionQuickBar IsVisible="@_selectionVisible" ClientX="@_selectionX" ClientY="@_selectionY" OnApplyHighlight="Highlight" OnDismiss="DismissSelection" />
    <footer class="folio-reader-status"><span>@(_loaded ? $"Page {_page + 1} of {_pages}" : "PDF reader")</span><div class="folio-reader-status-progress"><span style="width: @Progress%;"></span></div>
        @if (_saveError) { <button class="folio-subtle-btn folio-error-text" @onclick="() => Persist(true)">Position not saved · Retry</button> }
        else { <span class="folio-save-status">@(_loaded ? "Position saved automatically" : "Local PDF · Original preserved")</span> }
        <label class="folio-reader-light"><span>Page</span><select aria-label="Page lighting" @bind="_lighting" @bind:after="ApplyLighting"><option value="original">Original</option><option value="warm">Warm light</option></select></label>
    </footer>
</div>
@code {
    [Parameter, EditorRequired] public Book Book { get; set; } = default!;
    [Parameter] public int? InitialPageIndex { get; set; }
    [Parameter] public EventCallback OnBackToLibrary { get; set; }
    private DotNetObjectReference<ReaderView>? _reference;
    private readonly CancellationTokenSource _lifetime = new();
    private readonly SemaphoreSlim _saveLock = new(1, 1);
    private Task? _saveLoop;
    private Func<Task>? _closeSave;
    private bool _loaded, _disposed, _find, _contents, _zen, _bookmarked, _selectionVisible, _saveError, _passwordRequired;
    private int _page, _pages, _selectionPage, _match, _matches, _version, _savedVersion;
    private double _offset, _zoom = -2, _selectionX, _selectionY;
    private long _activeSeconds;
    private ReaderViewMode _mode = ReaderViewMode.Continuous;
    private DateTimeOffset _activity = DateTimeOffset.UtcNow, _trackedAt = DateTimeOffset.UtcNow;
    private string _query = "", _lighting = "original", _password = "", _selectionText = "";
    private string? _error;
    private IReadOnlyList<NormalizedRect> _selectionRects = [];
    private IReadOnlyList<BookmarkDto> _bookmarks = [];
    private List<OutlineNodeDto> _outline = [];
    private int Progress => (int)Math.Clamp(100.0 * (_page + 1) / Math.Max(1, _pages), 0, 100);
    protected override void OnInitialized()
    {
        _pages = Book.PageCount; _reference = DotNetObjectReference.Create(this);
        // Native close must not depend on a renderer that may already be tearing down.
        _closeSave = () => Persist(true, repaint: false); Session.SaveBeforeClose = _closeSave;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var position = await Use<IReadingPositionService, ReadingPosition?>(s => s.GetPositionAsync(Book.Id));
            if (position != null) { _page = position.PageIndex; _offset = position.OffsetPercent; _zoom = position.Zoom; _mode = position.ViewMode; }
            if (InitialPageIndex.HasValue) { _page = InitialPageIndex.Value; _offset = 0; }
            _page = Math.Clamp(_page, 0, Math.Max(0, _pages - 1));
            await Reader.InitAsync("folio-pdf-container", _reference!);
            await OpenDocument();
            _saveLoop = SaveLoop();
        }
        catch (Exception ex) { Logger.LogError(ex, "Reader initialization failed for {BookId}", Book.Id); _error = "The reader could not start. Return to the library and try again."; StateHasChanged(); }
    }
    private async Task<TValue> Use<TService, TValue>(Func<TService, Task<TValue>> action) where TService : notnull
    {
        await using var scope = Scopes.CreateAsyncScope();
        return await action(scope.ServiceProvider.GetRequiredService<TService>());
    }
    private async Task OpenDocument()
    {
        _loaded = false; _error = null; StateHasChanged();
        var url = await Urls.GetBookUrlAsync(Book);
        if (url == null) { _ = Stage.CompleteHandoffAsync(); _error = Platform.CanRelinkBooks ? "The managed PDF is missing. Locate the original document to restore it; your highlights are kept." : "This book's PDF is missing from this browser's storage. Import it again; your highlights are kept."; return; }
        await JS.InvokeVoidAsync("folioReader.loadDocument", url, _page, _offset, _zoom, _mode == ReaderViewMode.SinglePage ? "single" : "continuous", _password);
    }
    private async Task Retry() { await Reader.DisposeAsync(); await Reader.InitAsync("folio-pdf-container", _reference!); await OpenDocument(); }
    private async Task Locate()
    {
        var paths = await FilePicker.PickPdfFilesAsync(); if (paths.Count == 0) return;
        try { await Library.RelinkAsync(Book.Id, paths[0]); Book = (await Library.GetBookAsync(Book.Id))!; await Retry(); }
        catch (Exception ex) { Notifications.Add(ex.Message, Severity.Error); }
    }
    private async Task SaveLoop()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try { while (await timer.WaitForNextTickAsync(_lifetime.Token)) await InvokeAsync(() => Persist(false)); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }
    private async Task Persist(bool throwOnError, bool repaint = true)
    {
        if (!_loaded) return;
        await _saveLock.WaitAsync();
        try
        {
            var now = DateTimeOffset.UtcNow;
            if (now - _activity < TimeSpan.FromMinutes(2)) _activeSeconds += (long)Math.Max(0, Math.Min(5, (now - _trackedAt).TotalSeconds));
            _trackedAt = now;
            if (_savedVersion == _version && _activeSeconds == 0 && !_saveError) return;
            var version = _version; var seconds = _activeSeconds;
            await Use<IReadingPositionService, bool>(async s => { await s.SavePositionAsync(Book.Id, _page, _offset, _zoom, _mode, seconds); return true; });
            _activeSeconds -= seconds; _savedVersion = version; _saveError = false;
        }
        catch (Exception ex) { _saveError = true; Logger.LogError(ex, "Could not save position for {BookId}", Book.Id); if (throwOnError) throw; }
        finally { _saveLock.Release(); }
        if (!_disposed && repaint) await InvokeAsync(StateHasChanged);
    }
    [JSInvokable] public async Task OnDocumentLoaded(DocumentPayload payload)
    {
        _pages = payload.TotalPages; _loaded = true; _error = null; _password = ""; _version++;
        if (Book.PageCount != _pages) { await Library.SetPageCountAsync(Book.Id, _pages); Book.PageCount = _pages; }
        if (!Book.StatusIsManual && Book.Status == ReadingStatus.WantToRead) { await Library.SetStatusAsync(Book.Id, ReadingStatus.Reading, manual: false); Book.Status = ReadingStatus.Reading; }
        await LoadPage(_page); await RefreshBookmarks(); await ApplyLighting(); await InvokeAsync(StateHasChanged);
        // OPN-1: tell the opening book where this page is drawn so its 3D spread lands exactly on it.
        if (Stage.Phase == Folio.UI.Stage.StagePhase.Opening &&
            await JS.InvokeAsync<Folio.UI.Stage.PageRect?>("folioReader.currentPageRect") is { } rect)
            await Stage.ReportReaderPageAsync(rect);
    }
    [JSInvokable] public Task OnOutlineLoaded(List<OutlineNodeDto> outline) { _outline = outline; return InvokeAsync(StateHasChanged); }
    [JSInvokable] public async Task OnPositionChanged(PositionPayload payload)
    {
        if (_disposed) return;
        _activity = DateTimeOffset.UtcNow; var previous = _page;
        _page = Math.Clamp(payload.PageIndex, 0, Math.Max(0, _pages - 1)); _offset = payload.OffsetPercent; _zoom = payload.Zoom; _version++;
        if (_loaded && previous != _page) { await LoadPage(_page); _bookmarked = _bookmarks.Any(b => b.PageIndex == _page && b.IsDogEar); }
        await InvokeAsync(StateHasChanged);
    }
    [JSInvokable] public async Task OnPageRendered(int page)
    {
        if (_disposed) return;
        await LoadPage(page);
    }
    private async Task LoadPage(int page)
    {
        var annotations = await Use<IAnnotationService, IReadOnlyList<AnnotationDto>>(s => s.GetAnnotationsForPageAsync(Book.Id, page));
        if (_disposed) return;
        await Reader.DrawAnnotationsAsync(page, annotations.Select(a => new { id = a.Id.ToString(), type = a.Type.ToString(), colorHex = a.Color.ToHex(), rects = a.Rects }));
        await Reader.SetDogEarAsync(page, _bookmarks.Any(b => b.PageIndex == page && b.IsDogEar));
    }
    private async Task RefreshBookmarks() { _bookmarks = await Use<IBookmarkService, IReadOnlyList<BookmarkDto>>(s => s.GetBookmarksAsync(Book.Id)); _bookmarked = _bookmarks.Any(b => b.PageIndex == _page && b.IsDogEar); foreach (var bookmark in _bookmarks.Where(b => b.IsDogEar)) await Reader.SetDogEarAsync(bookmark.PageIndex, true); }
    [JSInvokable] public async Task OnDogEarToggled(int page) => await ToggleBookmark(page);
    private async Task ToggleBookmark(int page) { if (!_loaded) return; var result = await Use<IBookmarkService, BookmarkDto?>(s => s.ToggleDogEarAsync(Book.Id, page)); await Reader.SetDogEarAsync(page, result != null); await RefreshBookmarks(); await InvokeAsync(StateHasChanged); }
    private async Task DeleteBookmark(Guid id) { var bookmark = _bookmarks.FirstOrDefault(b => b.Id == id); await Use<IBookmarkService, bool>(s => s.DeleteBookmarkAsync(id)); if (bookmark != null) await Reader.SetDogEarAsync(bookmark.PageIndex, false); await RefreshBookmarks(); }
    private async Task NamedBookmark(string label) { await Use<IBookmarkService, BookmarkDto>(s => s.CreateNamedBookmarkAsync(new(Book.Id, _page, label))); await RefreshBookmarks(); }
    [JSInvokable] public Task OnTextSelected(TextSelectionDto selection)
    {
        _activity = DateTimeOffset.UtcNow; _selectionPage = selection.PageIndex; _selectionText = selection.SelectedText; _selectionRects = selection.Rects;
        _selectionX = selection.ClientX / Preferences.Current.FontScale; _selectionY = selection.ClientY / Preferences.Current.FontScale; _selectionVisible = true; return InvokeAsync(StateHasChanged);
    }
    [JSInvokable] public Task OnSelectionUnavailable() { Notifications.Add("Select text on one page at a time.", Severity.Info); return Task.CompletedTask; }
    private async Task Highlight((HighlightColor Color, AnnotationType Type) choice) => await CreateAnnotation(choice.Type, choice.Color);
    private async Task CreateAnnotation(AnnotationType type, HighlightColor color)
    {
        if (!_loaded || _selectionRects.Count == 0) return;
        try
        {
            var annotation = await Use<IAnnotationService, AnnotationDto>(s => s.CreateAnnotationAsync(new(Book.Id, _selectionPage, type, color, _selectionRects, _selectionText)));
            await LoadPage(_selectionPage); await DismissSelection();
        }
        catch (Exception ex) { Logger.LogError(ex, "Could not save annotation for {BookId}", Book.Id); Notifications.Add("The annotation could not be saved. Please try again.", Severity.Error); }
    }
    private async Task DismissSelection() { _selectionVisible = false; _selectionText = ""; _selectionRects = []; await Reader.ClearSelectionBoxAsync(); }
    [JSInvokable] public async Task OnAnnotationClicked(string id)
    {
        if (!Guid.TryParse(id, out var value)) return;
        var annotation = await Use<IAnnotationService, AnnotationDto?>(s => s.GetByIdAsync(value));
        if (annotation == null) return;
        await Reader.PulseAnnotationAsync(value);
        if (!await ConfirmActionDialog.ShowAsync(Dialogs, "Remove highlight?", "The highlighted text stays in the PDF; only Folio's mark is removed.", "Remove highlight", annotation.SelectedText)) return;
        await Use<IAnnotationService, bool>(s => s.DeleteAnnotationAsync(value));
        await LoadPage(annotation.PageIndex);
    }
    private async Task GoTo(int page) { if (!_loaded) return; await DismissSelection(); await Reader.GoToPageAsync(Math.Clamp(page, 0, _pages - 1)); }
    private async Task GoToDialog()
    {
        if (!_loaded) return;
        var dialog = await Dialogs.ShowAsync<GoToPageDialog>("Go to page", new DialogParameters<GoToPageDialog> { { x => x.CurrentPage, _page + 1 }, { x => x.TotalPages, _pages } });
        if (await dialog.Result is { Canceled: false, Data: int page }) await GoTo(page - 1);
    }
    private async Task FitWidth() { _zoom = -1; await Reader.SetFitWidthAsync(); }
    private async Task FitPage() { _zoom = -2; await Reader.SetFitPageAsync(); }
    private async Task ZoomBy(double delta) { _zoom = Math.Clamp((_zoom > 0 ? _zoom : 1) + delta, .25, 4); await Reader.SetZoomAsync(_zoom); }
    private async Task ToggleLayout() { _mode = _mode == ReaderViewMode.Continuous ? ReaderViewMode.SinglePage : ReaderViewMode.Continuous; _version++; await Reader.SetLayoutModeAsync(_mode == ReaderViewMode.SinglePage ? "single" : "continuous"); }
    private async Task ToggleFind() { _find = !_find; if (!_find) { _query = ""; await Reader.ClearSearchAsync(); } }
    private async Task Find(string query, bool forward = true) { _query = query; if (string.IsNullOrWhiteSpace(query)) { _matches = _match = 0; await Reader.ClearSearchAsync(); } else await Reader.SearchAsync(query, forward); }
    [JSInvokable] public Task OnSearchMatch(SearchPayload match) { _match = match.CurrentMatch; _matches = match.TotalMatches; return InvokeAsync(StateHasChanged); }
    private async Task ApplyLighting() => await Reader.ApplyThemeAsync(new { cssFilter = _lighting == "warm" ? "sepia(0.16)" : "none" });
    [JSInvokable] public Task OnReaderError(ErrorPayload error) { _ = Stage.CompleteHandoffAsync(); _loaded = false; _passwordRequired = error.Code == "password"; _error = _passwordRequired ? "Enter the document password. It is used only for this session." : "The PDF may be missing, damaged, or unavailable. Your notes and bookmarks are preserved."; return InvokeAsync(StateHasChanged); }
    [JSInvokable] public async Task OnExternalLinkRequested(string url)
    {
        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri) || uri.Scheme is not ("http" or "https")) return;
        if (await Dialogs.ShowMessageBox("Open external link?", uri.GetLeftPart(UriPartial.Authority), yesText: "Open in browser", cancelText: "Cancel") == true) await Links.OpenAsync(uri);
    }
    [JSInvokable] public async Task OnReaderShortcut(ShortcutPayload shortcut)
    {
        var key = shortcut.Key.ToLowerInvariant();
        if (shortcut.CtrlKey) { switch (key) { case "g": await GoToDialog(); break; case "f": await ToggleFind(); break; case "d": await ToggleBookmark(_page); break; case "k": await Commands(); break; case "+": case "=": await ZoomBy(.25); break; case "-": await ZoomBy(-.25); break; } }
        else if (key == "f11") _zen = !_zen;
        else if (key == "h" && _selectionVisible) await Highlight((HighlightColor.Yellow, AnnotationType.Highlight));
        else if (key == "escape") { if (_selectionVisible) await DismissSelection(); else if (_find) await ToggleFind(); else if (_contents) _contents = false; else if (_zen) _zen = false; else await Back(); }
        await InvokeAsync(StateHasChanged);
    }
    private async Task Commands()
    {
        var dialog = await Dialogs.ShowAsync<CommandPalette>("Reader commands");
        if (await dialog.Result is { Canceled: false, Data: string command }) switch (command) { case "goto": await GoToDialog(); break; case "find": await ToggleFind(); break; case "fitwidth": await FitWidth(); break; case "fitpage": await FitPage(); break; case "zoomin": await ZoomBy(.25); break; case "zoomout": await ZoomBy(-.25); break; case "rotate": await Reader.SetRotationAsync(90); break; case "layout": await ToggleLayout(); break; case "toc": _contents = !_contents; break; case "zen": _zen = !_zen; break; case "back": await Back(); break; }
    }
    private async Task Back() { try { await Persist(true); await OnBackToLibrary.InvokeAsync(); } catch { Notifications.Add("Position could not be saved. Retry before leaving the book.", Severity.Error); } }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; _lifetime.Cancel();
        if (_saveLoop != null) await _saveLoop;
        await Persist(false);
        if (Session.SaveBeforeClose == _closeSave) Session.SaveBeforeClose = null;
        await Reader.DisposeAsync(); await Urls.ReleaseBookUrlAsync(Book); _reference?.Dispose(); _lifetime.Dispose();
    }
    public record DocumentPayload(int TotalPages);
    public record PositionPayload(int PageIndex, double OffsetPercent, double Zoom);
    public record SearchPayload(int CurrentMatch, int TotalMatches, int PageIndex);
    public record ErrorPayload(string Code, string Message);
    public record ShortcutPayload(string Key, bool CtrlKey, bool AltKey);
}
