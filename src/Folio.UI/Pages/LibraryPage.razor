@page "/"
@page "/shelf"
@page "/shelf/{ShelfId:guid}"
@page "/trash"
@implements IAsyncDisposable
@inject ILibraryService Library
@inject FolioNavigator Navigator
@inject NavigationManager Navigation
@inject LibraryEvents Events
@inject SceneKeys Keys
@inject ShelfNavigator ShelfNav
@inject StageState Stage
@inject IJSRuntime JS

<PageTitle>@PageName · Folio</PageTitle>
@if (Mode == View.Hero)
{
    @* Hero scene (LIB-1, LIB-2): the stage draws the book; this layer carries everything readable and focusable. *@
    <section class="folio-stage-page folio-stage-hero">
        <LibraryHero @ref="_hero" Books="@HeroBooks" ShowBook="false" OnOpen="Open" OnCurrentChanged="HeroChanged">
            <Footer><BracketButton Label="BROWSE SHELVES" Plus="false" Hint="↓" AriaLabel="Browse shelves" Class="folio-browse" OnClick="() => Navigator.Go(FolioRoutes.Shelf())" /></Footer>
        </LibraryHero>
        <LibraryBottomBar @ref="_heroBar" Book="@(_hero?.Current ?? HeroBooks.FirstOrDefault())" OnOpen="Open" OnChanged="MenuChanged" />
        <div class="folio-sr-only" role="status" aria-live="polite">@_announcement</div>
    </section>
}
else if (Mode == View.Shelf)
{
    @* Shelf scene (LIB-3, LIB-5, SHF-1). The canvas is aria-hidden; the list below is the real, focusable library. *@
    <section class="folio-stage-page folio-stage-shelf" aria-labelledby="folio-shelf-title">
        <header class="folio-stage-shelf-head">
            <div>
                <div class="folio-eyebrow">[ SHELF · @RowName.ToUpperInvariant() · @_row.Count ]</div>
                <h1 id="folio-shelf-title" class="folio-display" tabindex="-1">@RowName</h1>
            </div>
            <label class="folio-sort"><span>Sort</span><select aria-label="Sort books" value="@_filter.Sort" @onchange="SortChanged">
                @foreach (var sort in Enum.GetValues<LibrarySort>()) { <option value="@sort">@SortName(sort)</option> }
            </select></label>
        </header>
        <div class="folio-status-filter" role="group" aria-label="Reading status">
            @foreach (var (status, label) in Statuses)
            {
                <BracketButton Label="@label" Plus="false" Class="@(_status == status ? "is-current" : "")" aria-pressed="@((_status == status).ToString().ToLowerInvariant())" OnClick="() => Navigator.Go(FolioRoutes.Shelf(ShelfId, status, Q))" />
            }
        </div>
        @if (_row.Count == 0)
        {
            <div class="folio-stage-empty">
                <p class="folio-display">@(_all.Count == 0 ? "Make room for a good book" : "No books here yet")</p>
                @if (_all.Count == 0) { <BracketButton Label="ADD BOOKS" AriaLabel="Add books to an empty library" OnClick="Import" /> }
                else { <p class="folio-muted">Add books with MOVE TO SHELF on their details, or change the filter.</p> }
            </div>
        }
        @* The presented book's title slides to the centre; its neighbours' titles are cut off at the edges (decorative: the list below is the real library). *@
        <div class="folio-marquee folio-shelf-marquee" aria-hidden="true" @ref="_marquee">
            <div class="folio-marquee-track">
                @foreach (var item in MarqueeBooks) { <span @key="item.Id" class="folio-marquee-title @(item.Id == _focusId ? "is-current" : "")">@item.Title</span> }
            </div>
        </div>
        <ul class="folio-focus-layer" aria-label="@($"Books on {RowName}")" @onfocusin="() => _layerFocused = true" @onfocusout="() => _layerFocused = false">
            @foreach (var book in _row)
            {
                <li @key="book.Id">
                    <button type="button" id="@BookButtonId(book.Id)" class="folio-focus-book @(book.Id == _focusId ? "is-focused" : "")" aria-haspopup="menu"
                        aria-label="@BookGeometry.AccessibleName(book)" @onfocus="() => Focus(book.Id)" @onclick="() => Open(book)"
                        @oncontextmenu="() => OpenMenuFor(book.Id)" @oncontextmenu:preventDefault="true">@book.Title</button>
                </li>
            }
        </ul>
        <LibraryBottomBar @ref="_shelfBar" Book="@FocusedBook" EmptyLabel="[ ← → TO BROWSE · ↑ ↓ FOR SHELVES ]" OnOpen="Open" OnChanged="MenuChanged" />
        <div class="folio-sr-only" role="status" aria-live="polite">@_announcement</div>
    </section>
}
else if (Mode == View.TwoD)
{
    <LibraryView @ref="_view" SearchQuery="@Q" StatusFilter="@_status" Shelf="@_shelf" Trash="@_trash" ShowHero="@_home"
        OnOpenBook="Open" OnImport="Import" OnChanged="Changed" />
}

@code {
    private enum View { Waiting, Hero, Shelf, TwoD }
    private static readonly (ReadingStatus? Status, string Label)[] Statuses =
        [(null, "ANY STATUS"), (ReadingStatus.Reading, "READING"), (ReadingStatus.WantToRead, "WANT TO READ"), (ReadingStatus.Finished, "FINISHED")];
    [Parameter] public Guid? ShelfId { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    /// <summary>A book to bring into focus on arrival (old /book/{id} links redirect here).</summary>
    [SupplyParameterFromQuery(Name = "book")] public Guid? FocusBook { get; set; }
    [CascadingParameter] public Layout.MainLayout? Layout { get; set; }
    private LibraryView? _view;
    private LibraryHero? _hero;
    private LibraryBottomBar? _heroBar, _shelfBar;
    private IAsyncDisposable? _keys;
    private IReadOnlyList<Book> _recent = [], _all = [], _row = [];
    private IReadOnlyList<Shelf> _shelves = [];
    private StageFilter _filter = new();
    private Shelf? _shelf;
    private ReadingStatus? _status;
    private Guid? _focusId;
    private bool _trash, _home, _shelfRoute, _loaded, _layerFocused;
    private string? _announcement;
    private Guid? _arrivedFor, _marqueeFor;
    private ElementReference _marquee;
    /// <summary>The presented book and up to 12 neighbours either side: enough to fill the marquee without a title per book.</summary>
    private IEnumerable<Book> MarqueeBooks { get { var i = Math.Max(0, _row.ToList().FindIndex(b => b.Id == _focusId)); return _row.Skip(Math.Max(0, i - 12)).Take(25); } }

    private View Mode => !_loaded || (Stage.Starting && !_trash) ? View.Waiting
        : Stage.Available && _home && string.IsNullOrWhiteSpace(Q) && HeroBooks.Count > 0 ? View.Hero
        : Stage.Available && (_shelfRoute || (_home && _all.Count == 0)) ? View.Shelf
        : View.TwoD;
    /// <summary>LIB-1: the most recently read books; before anything is read, the newest additions.</summary>
    private IReadOnlyList<Book> HeroBooks => _recent.Count > 0 ? _recent : _all.Take(8).ToList();
    private string RowName => _shelf?.Name ?? "All books";
    private Book? FocusedBook => _row.FirstOrDefault(b => b.Id == _focusId);
    private string ShelfAnnouncement => $"Shelf: {RowName}, {_row.Count} {(_row.Count == 1 ? "book" : "books")}";
    private string PageName => _trash ? "Trash" : _shelf?.Name ?? (_status != null ? _status.ToString()! : "Library");
    private static string BookButtonId(Guid id) => $"folio-book-{id:N}";
    private static string SortName(LibrarySort sort) => sort switch { LibrarySort.Added => "Date added", _ => sort.ToString() };

    protected override void OnInitialized()
    {
        Events.Changed += Reload;
        Stage.Changed += StageChanged;
        Stage.Activated += StageActivated;
        Stage.ScrollIntent += StageScroll;
        Stage.Hovered += StageHovered;
        Stage.Settled += StageSettled;
        ShelfNav.TargetChanged += TargetChanged;
        ShelfNav.RowsChanged += RowsChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        _trash = path == "trash";
        _home = path.Length == 0;
        _shelfRoute = path == "shelf" || path.StartsWith("shelf/", StringComparison.Ordinal);
        _status = Enum.TryParse<ReadingStatus>(Status, true, out var status) ? status : null;
        await ShelfNav.RefreshAsync();
        _shelves = ShelfNav.Shelves;
        if (!ResolveShelf()) return;
        // Back, Forward, typed addresses and sidebar clicks set the target row; a route that matches it does nothing.
        if (_shelfRoute) ShelfNav.SyncFromRoute(ShelfId);
        _filter = new StageFilter(Enum.TryParse<LibrarySort>(Sort, true, out var sort) ? sort : LibrarySort.Recent, _shelfRoute ? _status : null, _shelfRoute ? Q : null);
        await LoadAsync();
    }

    /// <summary>Finds the shelf named in the address among the current rows; a shelf that no longer exists goes home.</summary>
    private bool ResolveShelf()
    {
        _shelf = ShelfId is { } id ? _shelves.FirstOrDefault(s => s.Id == id) : null;
        if (ShelfId != null && _shelf == null) { Navigator.Go(FolioRoutes.Home, replace: true); return false; }
        return true;
    }

    private async Task LoadAsync()
    {
        if (!_trash)
        {
            _recent = _home ? await Library.GetRecentAsync() : [];
            _all = await Library.GetAllAsync(_filter.Sort);
            _row = StageFilter.Row(_filter.Apply(_all), ShelfId);
            if (FocusBook is { } wanted && _row.Any(b => b.Id == wanted) && _arrivedFor != wanted) { _focusId = wanted; _arrivedFor = wanted; }
            else if (_focusId == null || _row.All(b => b.Id != _focusId)) _focusId = _row.FirstOrDefault()?.Id;
        }
        _loaded = true;
        UpdateStage();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _keys = await Keys.AttachAsync(Key);
        if (Mode == View.Shelf && _focusId != _marqueeFor && _row.Count > 0) { _marqueeFor = _focusId; await JS.InvokeVoidAsync("folioShell.centerMarquee", _marquee); }
    }

    private void UpdateStage()
    {
        switch (Mode)
        {
            case View.Hero:
                Stage.SetFilter(new());
                Stage.Show(StageScene.Hero((_hero?.Current ?? HeroBooks[0]).Id), this);
                break;
            case View.Shelf:
                Stage.SetFilter(_filter);
                Stage.Show(StageScene.Shelf(ShelfNav.TargetIndex, ShelfNav.RowsVersion, _focusId), this);
                // Announce the scene when it is shown; the stage's settle event repeats it once the camera arrives.
                _announcement = ShelfAnnouncement;
                break;
            case View.TwoD:
                Stage.Release(this);
                break;
        }
    }

    // ---- focus: DOM focus and 3D focus follow each other --------------------------------------------------------------

    private void Focus(Guid id)
    {
        if (_focusId == id) return;
        _focusId = id;
        if (Mode == View.Shelf) Stage.Show(StageScene.Shelf(ShelfNav.TargetIndex, ShelfNav.RowsVersion, id), this);
    }

    private async Task MoveFocus(int delta)
    {
        if (_row.Count == 0) return;
        var index = _row.ToList().FindIndex(b => b.Id == _focusId);
        // The first arrow press moves keyboard focus onto the focused book; later presses move along the row.
        var next = _layerFocused ? _row[Math.Clamp(index + delta, 0, _row.Count - 1)] : FocusedBook ?? _row[0];
        Focus(next.Id);
        StateHasChanged();
        await JS.InvokeVoidAsync("folioShell.focusElement", BookButtonId(next.Id));
    }

    private void StageHovered(Guid id) => _ = InvokeAsync(async () =>
    {
        if (Mode != View.Shelf || _row.All(b => b.Id != id)) return;
        Focus(id);
        StateHasChanged();
        await JS.InvokeVoidAsync("folioShell.focusElement", BookButtonId(id));
    });

    private void StageSettled(string kind, int rowIndex) => _ = InvokeAsync(() =>
    {
        if (kind == "shelf") ShelfNav.OnSettled(rowIndex);
        _announcement = kind switch
        {
            "shelf" when Mode == View.Shelf => ShelfAnnouncement,
            "hero" when Mode == View.Hero => $"Continue reading: {(_hero?.Current ?? HeroBooks.FirstOrDefault())?.Title}",
            _ => _announcement
        };
        StateHasChanged();
    });

    private void StageChanged() => _ = InvokeAsync(() => { UpdateStage(); StateHasChanged(); });
    private Task HeroChanged(Book book) { if (Mode == View.Hero) Stage.Show(StageScene.Hero(book.Id), this); return Task.CompletedTask; }

    private async Task StageActivated(Guid id, string action)
    {
        switch (action)
        {
            case "open": await Navigator.OpenBookAsync(id); break;
            case "menu": await OpenMenuFor(id); break;
            default: // "present": a click or a 250 ms rest on a book brings it forward
                await InvokeAsync(() => { var book = _row.FirstOrDefault(b => b.Id == id); if (book != null) { Focus(id); _announcement = BookGeometry.AccessibleName(book); StateHasChanged(); } });
                break;
        }
    }

    /// <summary>Right-click or the context-menu key: focus the book, then open its menu (Edit, Move to shelf, Trash).</summary>
    private async Task OpenMenuFor(Guid id)
    {
        if (_row.All(b => b.Id != id) && HeroBooks.All(b => b.Id != id)) return;
        if (Mode == View.Shelf) { Focus(id); StateHasChanged(); await Task.Yield(); await (_shelfBar?.OpenMenuAsync() ?? Task.CompletedTask); }
        else if (Mode == View.Hero) await (_heroBar?.OpenMenuAsync() ?? Task.CompletedTask);
    }

    private Task MenuChanged() => Layout?.NotifyLibraryChangedAsync() ?? Task.CompletedTask;

    private Task StageScroll(string direction) => InvokeAsync(() => StepRow(direction == "down" ? 1 : -1, repeat: false));

    /// <summary>Up/down through Hero → All books → each shelf (LIB-3, SHF-1). One gesture or key press moves one row (WP2).</summary>
    private void StepRow(int delta, bool repeat)
    {
        if (Mode == View.Hero) { if (delta > 0 && !repeat) Navigator.Go(FolioRoutes.Shelf()); return; }
        if (Mode != View.Shelf) return;
        if (delta < 0 && ShelfNav.TargetIndex == 0) { if (!repeat) Navigator.Go(FolioRoutes.Home); return; }
        ShelfNav.Step(delta, repeat);
    }

    /// <summary>The navigator chose a new target row: the camera starts at once, and the address follows it.</summary>
    private void TargetChanged(int index) => _ = InvokeAsync(() =>
    {
        if (Mode != View.Shelf) return;
        UpdateStage();
        Navigator.Go(FolioRoutes.Shelf(ShelfNav.Rows[index].Id, _status, Q));
    });

    private void RowsChanged() => _ = InvokeAsync(() => { if (Mode == View.Shelf) UpdateStage(); StateHasChanged(); });

    private async Task Key(string key, bool shift, bool repeat)
    {
        var book = Mode switch { View.Hero => _hero?.Current ?? HeroBooks.FirstOrDefault(), View.Shelf => FocusedBook, _ => _view?.FocusedBook };
        switch (key)
        {
            case "Enter" when book != null: await Open(book); break;
            case "ArrowLeft" or "ArrowRight":
                var delta = key == "ArrowLeft" ? -1 : 1;
                if (Mode == View.Shelf) await MoveFocus(delta);
                else if (Mode == View.Hero) _hero?.Step(delta);
                else _view?.StepHero(delta);
                break;
            case "ArrowDown": StepRow(1, repeat); break;
            case "ArrowUp": StepRow(-1, repeat); break;
            case "Escape" when !_home: Navigator.Go(FolioRoutes.Home); break;
            case [var digit] when char.IsAsciiDigit(digit) && digit != '0' && digit - '1' < _shelves.Count:
                // Shelf n is row n (row 0 is All books). The navigator sets the target; the address follows.
                if (Mode != View.Shelf) Navigator.Go(FolioRoutes.Shelf(_shelves[digit - '1'].Id));
                else if (!ShelfNav.GoTo(digit - '0')) Navigator.Go(FolioRoutes.Shelf(_shelves[digit - '1'].Id, _status, Q));
                break;
        }
    }

    private void SortChanged(ChangeEventArgs e)
    {
        var sort = Enum.TryParse<LibrarySort>(e.Value?.ToString(), out var s) ? s : LibrarySort.Recent;
        var url = FolioRoutes.Shelf(ShelfId, _status, Q);
        Navigator.Go(url + (url.Contains('?') ? "&" : "?") + $"sort={sort}", replace: true);
    }

    private Task Open(Book book) => Open(book.Id);
    private Task Open(Guid id) => Navigator.OpenBookAsync(id, null, Mode == View.TwoD ? $"[data-book-id=\"{id}\"] .folio-cssbook" : null);
    private Task Import() => Layout?.ImportBooks() ?? Task.CompletedTask;
    private Task Changed() => Layout?.RefreshNavigation() ?? Task.CompletedTask;
    private async Task Reload()
    {
        await ShelfNav.RefreshAsync();
        _shelves = ShelfNav.Shelves;
        if (!ResolveShelf()) return;               // renamed shelves show their new name; deleted ones go home
        await LoadAsync();
        if (_view != null) await _view.RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Events.Changed -= Reload;
        Stage.Changed -= StageChanged;
        Stage.Activated -= StageActivated;
        Stage.ScrollIntent -= StageScroll;
        Stage.Hovered -= StageHovered;
        Stage.Settled -= StageSettled;
        ShelfNav.TargetChanged -= TargetChanged;
        ShelfNav.RowsChanged -= RowsChanged;
        Stage.Release(this);
        if (_keys != null) await _keys.DisposeAsync();
    }
}
