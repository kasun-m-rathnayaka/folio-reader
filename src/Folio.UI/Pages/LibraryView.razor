@using Microsoft.AspNetCore.Components.Web.Virtualization
@implements IAsyncDisposable
@inject ILibraryService Library
@inject IAppPreferencesService Preferences
@inject IDialogService Dialogs
@inject NotificationService Notifications
@inject IJSRuntime JS

<section class="folio-library-page">
    <div class="folio-library-intro">
        <div><div class="folio-eyebrow">@(_isTrash ? "RECOVER YOUR BOOKS" : "A LITTLE SPACE TO READ")</div><h1>@Title</h1><p>@(_isTrash ? "Removed books keep their notes and reading position. Restore them whenever you need." : "Your books, your notes, your own pace.")</p></div>
        <span class="folio-library-count">@_total @(_total == 1 ? "book" : "books")</span>
    </div>
    @if (!_isTrash && StatusFilter == null && Shelf == null && string.IsNullOrWhiteSpace(SearchQuery) && _recent.Count > 0)
    {
        <ContinueReadingCarousel Books="@_recent" OnOpenBook="OnOpenBook" />
    }
    <div class="folio-library-controls">
        <div><h2>@(_isTrash ? "Removed books" : "All books")</h2><span class="folio-muted">@(string.IsNullOrWhiteSpace(SearchQuery) ? "Choose something worth your time." : $"Results for “{SearchQuery}”")</span></div>
        <div class="folio-controls-right"><label class="folio-sort"><span>Sort by</span><select aria-label="Sort books" @bind="_sort" @bind:after="RefreshAsync"><option value="Recent">Recent</option><option value="Title">Title</option><option value="Author">Author</option><option value="Added">Date added</option><option value="Progress">Progress</option></select></label>
            <div class="folio-segmented"><button class="@(_grid ? "active" : "")" aria-label="Grid view" aria-pressed="@_grid" @onclick="() => SetGrid(true)"><MudIcon Icon="@Icons.Material.Outlined.GridView" Size="Size.Small" /></button><button class="@(!_grid ? "active" : "")" aria-label="List view" aria-pressed="@(!_grid)" @onclick="() => SetGrid(false)"><MudIcon Icon="@Icons.Material.Outlined.ViewList" Size="Size.Small" /></button></div>
        </div>
    </div>
    @if (_error != null)
    {
        <div class="folio-empty-state" role="alert"><h2>We couldn’t load your library</h2><p>@_error</p><button class="folio-primary-btn" @onclick="RefreshAsync">Try again</button></div>
    }
    else if (_loading) { <div class="folio-empty-state"><MudProgressCircular Indeterminate="true" Size="Size.Small" /><p>Loading your books…</p></div> }
    else if (_total == 0)
    {
        <div class="folio-empty-state"><div class="folio-empty-icon"><MudIcon Icon="@Icons.Material.Outlined.LocalLibrary" /></div>
            <h2>@(_isTrash ? "Nothing in Trash" : string.IsNullOrWhiteSpace(SearchQuery) && StatusFilter == null && Shelf == null ? "Make room for a good book" : "No books match this view")</h2>
            <p>@(_isTrash ? "Books you remove from your library will appear here." : string.IsNullOrWhiteSpace(SearchQuery) && StatusFilter == null && Shelf == null ? "Add a PDF to start a library that feels like yours." : "Try another search, reading status, or shelf.")</p>
            @if (!_isTrash) { <button class="folio-primary-btn" @onclick="OnImport"><MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />Add books</button> }
        </div>
    }
    <div id="folio-library-grid" class="folio-books-scroll" style="display: @(_total > 0 && !_loading && _error == null ? "block" : "none");">
        <Virtualize @ref="_virtual" TItem="LibraryRow" ItemsProvider="LoadRows" ItemSize="@(_grid ? 340 : 88)" OverscanCount="2">
            <ItemContent Context="row"><div class="@(_grid ? "folio-book-row" : "folio-book-list-row")" style="@(_grid ? $"grid-template-columns: repeat({_columns}, minmax(0, 1fr));" : "")">
                @foreach (var book in row.Books) { <BookCard @key="book.Id" Book="book" ListMode="@(!_grid)" Trash="@_isTrash" OnOpen="OnOpenBook" OnStatusChanged="StatusChanged" OnRemove="Remove" OnEdit="Edit" /> }
            </div></ItemContent>
            <Placeholder><div class="folio-row-placeholder" style="height: @(_grid ? "340px" : "88px");"><span>Loading books…</span></div></Placeholder>
        </Virtualize>
    </div>
</section>
@code {
    [Parameter] public string? SearchQuery { get; set; }
    [Parameter] public ReadingStatus? StatusFilter { get; set; }
    [Parameter] public Shelf? Shelf { get; set; }
    [Parameter] public bool Trash { get; set; }
    [Parameter] public EventCallback<Book> OnOpenBook { get; set; }
    [Parameter] public EventCallback OnImport { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private Virtualize<LibraryRow>? _virtual;
    private DotNetObjectReference<LibraryView>? _reference;
    private IReadOnlyList<Book> _recent = [];
    private int _columns = 4, _total;
    private bool _grid = true, _loading = true, _isTrash;
    private LibrarySort _sort = LibrarySort.Recent;
    private string? _filterKey, _error;
    private string Title => _isTrash ? "Trash" : Shelf?.Name ?? StatusFilter switch { ReadingStatus.Reading => "Currently reading", ReadingStatus.WantToRead => "Want to read", ReadingStatus.Finished => "Finished books", _ => "Your library" };
    private record LibraryRow(IReadOnlyList<Book> Books);
    protected override void OnInitialized() { _grid = Preferences.Current.GridView; _reference = DotNetObjectReference.Create(this); }
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{SearchQuery}|{StatusFilter}|{Shelf?.Id}|{Trash}";
        if (_filterKey != key) { _filterKey = key; _isTrash = Trash; await RefreshAsync(); }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) await JS.InvokeVoidAsync("folioShell.observeGrid", _reference); }
    private LibraryQuery Query(int start, int count) => new(SearchQuery, StatusFilter, Shelf?.Id, _isTrash, _sort, start, count);
    private async ValueTask<ItemsProviderResult<LibraryRow>> LoadRows(ItemsProviderRequest request)
    {
        var columns = _grid ? _columns : 1;
        var page = await Library.QueryAsync(Query(request.StartIndex * columns, Math.Min(request.Count * columns, 200)), request.CancellationToken);
        var rows = page.Books.Chunk(columns).Select(b => new LibraryRow(b)).ToList();
        return new(rows, (int)Math.Ceiling((double)page.Total / columns));
    }
    public async Task RefreshAsync()
    {
        _error = null;
        try { _total = (await Library.QueryAsync(Query(0, 1))).Total; _recent = await Library.GetRecentAsync(); if (_virtual != null) await _virtual.RefreshDataAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        _loading = false; await InvokeAsync(StateHasChanged);
    }
    [JSInvokable] public async Task OnColumnsChanged(int columns) { columns = Math.Clamp(columns, 1, 8); if (_columns == columns) return; _columns = columns; if (_virtual != null) await _virtual.RefreshDataAsync(); await InvokeAsync(StateHasChanged); }
    private async Task SetGrid(bool grid) { _grid = grid; Preferences.Save(Preferences.Current with { GridView = grid }); await RefreshAsync(); }
    private async Task StatusChanged((Book Book, ReadingStatus Status) change) { await Library.SetStatusAsync(change.Book.Id, change.Status); await RefreshAsync(); await OnChanged.InvokeAsync(); }
    private async Task Remove(Book book) { await Library.SetTrashAsync(book.Id, !_isTrash); Notifications.Add(_isTrash ? "Book restored with its notes and position." : "Moved to Trash. Your notes and position are kept.", Severity.Info); await RefreshAsync(); await OnChanged.InvokeAsync(); }
    private async Task Edit(Book book) { var dialog = await Dialogs.ShowAsync<EditBookDialog>("Book details", new DialogParameters<EditBookDialog> { { x => x.Book, book } }, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small }); if (await dialog.Result is { Canceled: false }) { await RefreshAsync(); await OnChanged.InvokeAsync(); } }
    public async ValueTask DisposeAsync() { try { await JS.InvokeVoidAsync("folioShell.disconnectGrid"); } catch (JSDisconnectedException) { } _reference?.Dispose(); }
}
