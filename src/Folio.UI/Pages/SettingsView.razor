@inject IAppPreferencesService Preferences
@inject IPlatformCapabilities Platform
@inject IServiceProvider Services
@inject IDialogService Dialogs
@inject NotificationService Notifications
@inject NavigationManager Navigation
<section class="folio-settings-page">
    <div class="folio-eyebrow">[ SETTINGS ]</div><h1 class="folio-display">Settings</h1><p class="folio-muted">A comfortable reading space, saved on this device.</p>
    <div class="folio-settings-group"><h2 class="folio-eyebrow">[ APPEARANCE ]</h2>
        <MudSwitch T="bool" Value="@Preferences.Current.DarkMode" ValueChanged="ToggleDark" Color="Color.Primary" Label="Dark appearance" />
        <label class="folio-settings-row">Interface text size <select aria-label="Interface text size" value="@Preferences.Current.FontScale" @onchange="SetScale"><option value="1">100%</option><option value="1.25">125%</option><option value="1.5">150%</option><option value="2">200%</option></select></label>
    </div>
    <div class="folio-settings-group"><h2 class="folio-eyebrow">[ LIBRARY ]</h2>
        <fieldset class="folio-settings-choice"><legend>Motion</legend>
            @foreach (var (value, label, hint) in MotionChoices)
            {
                <label><input type="radio" name="folio-motion" checked="@(Preferences.Current.Motion == value)" @onchange="() => Save(Preferences.Current with { Motion = value })" /><span>@label</span><small>@hint</small></label>
            }
        </fieldset>
        <fieldset class="folio-settings-choice"><legend>Library style</legend>
            <label><input type="radio" name="folio-style" checked="@(Preferences.Current.LibraryStyle == LibraryStyle.ThreeD)" @onchange="() => Save(Preferences.Current with { LibraryStyle = LibraryStyle.ThreeD })" /><span>3D</span><small>Books on a stage. Falls back to 2D when this device cannot draw 3D.</small></label>
            <label><input type="radio" name="folio-style" checked="@(Preferences.Current.LibraryStyle == LibraryStyle.TwoD)" @onchange="() => Save(Preferences.Current with { LibraryStyle = LibraryStyle.TwoD })" /><span>2D</span><small>Flat pages with CSS books. Lightest on battery and older graphics.</small></label>
        </fieldset>
        <fieldset class="folio-settings-choice"><legend>Reading view</legend>
            <label><input type="radio" name="folio-reading" checked="@(Preferences.Current.ReadingView == ReadingView.Book3D)" @onchange="() => Save(Preferences.Current with { ReadingView = ReadingView.Book3D })" /><span>3D book</span><small>The book opens and you turn its pages. Needs 3D; Zoom (Z) shows flat pages any time.</small></label>
            <label><input type="radio" name="folio-reading" checked="@(Preferences.Current.ReadingView == ReadingView.Flat)" @onchange="() => Save(Preferences.Current with { ReadingView = ReadingView.Flat })" /><span>Flat pages</span><small>Scrolling pages, best for long or dense documents.</small></label>
        </fieldset>
        <fieldset class="folio-settings-choice"><legend>3D quality</legend>
            @foreach (var (value, label, hint) in QualityChoices)
            {
                <label><input type="radio" name="folio-quality" checked="@(Preferences.Current.Quality == value)" @onchange="() => Save(Preferences.Current with { Quality = value })" /><span>@label</span><small>@hint</small></label>
            }
        </fieldset>
    </div>
    @if (Platform.SupportsLibraryBackup && Backup != null)
    {
        <div class="folio-settings-group"><h2 class="folio-eyebrow">[ LIBRARY BACKUP ]</h2>
            <p class="folio-muted">Your books live in this browser's private storage. Browsers can clear it, so keep a backup: one file with your books, highlights, bookmarks and reading positions.</p>
            @if (_storage != null)
            {
                <p class="folio-mono folio-storage-status">@FormatBytes(_storage.UsedBytes) USED · @(_storage.Persistent ? "PROTECTED FROM CLEARING" : "MAY BE CLEARED BY THE BROWSER")</p>
            }
            <div class="folio-settings-actions">
                <BracketButton Label="EXPORT BACKUP" Disabled="@_busy" OnClick="ExportBackup" />
                <BracketButton Label="RESTORE FROM BACKUP" Plus="false" Disabled="@_busy" OnClick="ImportBackup" />
            </div>
            @if (_busy) { <MudProgressLinear Color="Color.Primary" Value="@(_progress * 100)" aria-label="Backup progress" /> }
        </div>
    }
    <div class="folio-settings-group"><h2 class="folio-eyebrow">[ SHORTCUTS ]</h2><dl class="folio-shortcuts">
        <dt>Open focused book</dt><dd>Enter</dd><dt>Book menu</dt><dd>Right-click or Menu key</dd><dt>Shelf 1–9</dt><dd>1 – 9</dd><dt>Back</dt><dd>Esc</dd>
        <dt>Turn page (3D book)</dt><dd>← → · Page Up / Down</dd><dt>First or last page</dt><dd>Home · End</dd><dt>Flat pages (Zoom)</dt><dd>Z</dd><dt>Find in book</dt><dd>Ctrl F</dd><dt>Go to page</dt><dd>Ctrl G</dd><dt>Bookmark page</dt><dd>Ctrl D</dd><dt>Reader commands</dt><dd>Ctrl K</dd><dt>Focus mode</dt><dd>F11</dd></dl></div>
</section>
@code {
    [Parameter] public EventCallback OnPreferencesChanged { get; set; }
    private static readonly (MotionPreference, string, string)[] MotionChoices =
    [
        (MotionPreference.System, "Match system", "Follows your device's reduce-motion setting."),
        (MotionPreference.Full, "Full", "Books turn, tilt and travel."),
        (MotionPreference.Reduced, "Reduced", "No idle motion or camera travel; short crossfades."),
        (MotionPreference.Off, "Off", "Instant changes."),
    ];
    private static readonly (StageQuality, string, string)[] QualityChoices =
    [
        (StageQuality.Auto, "Auto", "Lowers detail if drawing becomes slow."),
        (StageQuality.High, "High", "Sharpest books and soft shadows."),
        (StageQuality.Low, "Low", "Lower resolution, no shadows."),
    ];
    private ILibraryBackupService? Backup => Services.GetService(typeof(ILibraryBackupService)) as ILibraryBackupService;
    private StorageStatus? _storage;
    private bool _busy;
    private double _progress;
    protected override async Task OnInitializedAsync() { if (Platform.SupportsLibraryBackup && Backup != null) _storage = await Backup.GetStorageStatusAsync(); }
    private static string FormatBytes(long bytes) => bytes >= 1 << 30 ? $"{bytes / (double)(1 << 30):0.0} GB" : bytes >= 1 << 20 ? $"{bytes / (double)(1 << 20):0.0} MB" : $"{bytes / 1024.0:0} KB";
    private Progress<double> Reporter() => new(p => { _progress = p; StateHasChanged(); });

    private async Task ExportBackup()
    {
        _busy = true; _progress = 0;
        try
        {
            var result = await Backup!.ExportAsync(Reporter());
            Preferences.Save(Preferences.Current with { BackupReminderAt = DateTimeOffset.UtcNow });
            Notifications.Add($"Saved {result.FileName} with {result.Books} {(result.Books == 1 ? "book" : "books")}.", Severity.Success, "Backup exported");
        }
        catch (Exception ex) { Notifications.Add(ex.Message, Severity.Error, "Backup failed"); }
        finally { _busy = false; }
    }

    private async Task ImportBackup()
    {
        if (!await ConfirmActionDialog.ShowAsync(Dialogs, "Restore from a backup?", "Your current library in this browser will be replaced by the backup's books, highlights, bookmarks and positions.", "Choose backup", detail: "Export a backup first if you want to keep what is here now.")) return;
        _busy = true; _progress = 0;
        try
        {
            var result = await Backup!.ImportAsync(Reporter());
            if (!result.Completed) { if (result.Message != "No backup chosen.") Notifications.Add(result.Message ?? "The backup could not be restored.", Severity.Error, "Restore failed"); return; }
            // Every view and cache starts again from the restored library.
            Navigation.NavigateTo(Navigation.BaseUri, forceLoad: true);
        }
        catch (Exception ex) { Notifications.Add(ex.Message, Severity.Error, "Restore failed"); }
        finally { _busy = false; }
    }

    private async Task Save(AppPreferences preferences) { Preferences.Save(preferences); await OnPreferencesChanged.InvokeAsync(); }
    private Task ToggleDark(bool value) => Save(Preferences.Current with { DarkMode = value });
    private async Task SetScale(ChangeEventArgs e) { if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var scale)) await Save(Preferences.Current with { FontScale = scale }); }
}
