@inject IAppPreferencesService Preferences
<section class="folio-settings-page"><div class="folio-eyebrow">MAKE YOURSELF AT HOME</div><h1>Settings</h1><p class="folio-muted">A comfortable reading space, saved on this device.</p>
    <div class="folio-settings-group"><h2>Appearance</h2>
        <MudSwitch T="bool" Value="@Preferences.Current.DarkMode" ValueChanged="ToggleDark" Color="Color.Primary" Label="Dark appearance" />
        <label class="folio-settings-scale">Interface text size <select aria-label="Interface text size" value="@Preferences.Current.FontScale" @onchange="SetScale"><option value="1">100%</option><option value="1.25">125%</option><option value="1.5">150%</option><option value="2">200%</option></select></label>
    </div>
    <div class="folio-settings-group"><h2>Reading shortcuts</h2><dl class="folio-shortcuts"><dt>Find in book</dt><dd>Ctrl F</dd><dt>Go to page</dt><dd>Ctrl G</dd><dt>Bookmark page</dt><dd>Ctrl D</dd><dt>Reader commands</dt><dd>Ctrl K</dd><dt>Focus mode</dt><dd>F11</dd><dt>Return / close panel</dt><dd>Esc</dd></dl></div>
</section>
@code {
    [Parameter] public EventCallback OnPreferencesChanged { get; set; }
    private async Task ToggleDark(bool value) { Preferences.Save(Preferences.Current with { DarkMode = value }); await OnPreferencesChanged.InvokeAsync(); }
    private async Task SetScale(ChangeEventArgs e) { if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var scale)) { Preferences.Save(Preferences.Current with { FontScale = scale }); await OnPreferencesChanged.InvokeAsync(); } }
}
