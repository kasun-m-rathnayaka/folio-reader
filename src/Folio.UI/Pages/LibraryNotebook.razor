@inject ILibraryService Library
<section class="folio-notebook-page">
    <div class="folio-eyebrow">THOUGHTS WORTH KEEPING</div><h1>Your notebook</h1><p class="folio-muted">Highlights and notes, with a path back to the page.</p>
    @if (_notes.Count == 0) { <div class="folio-empty-state"><MudIcon Icon="@Icons.Material.Outlined.EditNote" Size="Size.Large" /><h2>@(string.IsNullOrWhiteSpace(Search) ? "Your thoughts belong here" : "No matching notes")</h2><p>Select text in a book to highlight it or add a margin note.</p></div> }
    @foreach (var note in _notes)
    {
        <article class="folio-notebook-entry" style="border-left-color: @note.Annotation.Color.ToHex();">
            <div class="folio-section-heading"><strong>@note.BookTitle</strong><button class="folio-subtle-btn" @onclick="() => OnOpen.InvokeAsync((note.Annotation.BookId, note.Annotation.PageIndex))">Page @(note.Annotation.PageIndex + 1) <span aria-hidden="true">↗</span></button></div>
            @if (!string.IsNullOrEmpty(note.Annotation.SelectedText)) { <blockquote>@note.Annotation.SelectedText</blockquote> }
            @if (!string.IsNullOrEmpty(note.Annotation.Note)) { <p>@note.Annotation.Note</p> }
            <small class="folio-muted">@note.Annotation.Type · @note.Annotation.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</small>
        </article>
    }
</section>
@code {
    [Parameter] public string? Search { get; set; }
    [Parameter] public EventCallback<(Guid BookId, int PageIndex)> OnOpen { get; set; }
    private IReadOnlyList<LibraryNote> _notes = [];
    protected override async Task OnParametersSetAsync() => _notes = await Library.GetNotesAsync(Search);
}
