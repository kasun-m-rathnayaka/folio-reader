<div class="mb-6">
    <div class="d-flex align-center justify-space-between mb-3">
        <MudText Typo="Typo.h6" Class="font-weight-bold">
            Continue Reading
        </MudText>
    </div>

    @if (Books == null || Books.Count == 0)
    {
        <MudPaper Elevation="0" Class="pa-4" Style="background-color: var(--md-sys-color-surface-container-low); border-radius: 12px; border: 1px solid var(--md-sys-color-outline);">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Pick up a book from your library to start reading here.
            </MudText>
        </MudPaper>
    }
    else
    {
        <div class="d-flex gap-4 overflow-x-auto pb-2" style="scrollbar-width: thin;">
            @foreach (var book in Books)
            {
                int currPage = (book.ReadingPosition?.PageIndex ?? 0) + 1;
                int totalPages = Math.Max(1, book.PageCount);
                int progress = (int)Math.Clamp(Math.Round((double)currPage / totalPages * 100), 0, 100);

                <MudCard Elevation="1" Class="d-flex flex-column folio-book-card"
                         Style="min-width: 280px; max-width: 320px; border-radius: 12px; cursor: pointer;"
                         @onclick="@(() => OnOpenBook.InvokeAsync(book))">
                    <div style="height: 140px; background-color: var(--md-sys-color-surface-container-high); position: relative; overflow: hidden;">
                        @if (!string.IsNullOrEmpty(book.CoverPath) && System.IO.File.Exists(book.CoverPath))
                        {
                            <img src="@($"file:///{book.CoverPath.Replace('\\', '/')}")"
                                 alt="@book.Title"
                                 style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="folio-book-spine-placeholder" style="height: 100%;">
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@book.Title</MudText>
                                @if (!string.IsNullOrEmpty(book.Author))
                                {
                                    <MudText Typo="Typo.caption">@book.Author</MudText>
                                }
                            </div>
                        }
                    </div>

                    <MudCardContent Class="pa-3">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold text-truncate">
                            @book.Title
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate">
                            @(book.Author ?? "Unknown Author")
                        </MudText>

                        <div class="d-flex align-center justify-space-between mt-3">
                            <div class="d-flex align-center gap-2">
                                <MudProgressCircular Color="Color.Primary"
                                                     Size="Size.Small"
                                                     Value="@progress" />
                                <MudText Typo="Typo.caption" Class="font-weight-medium">
                                    p. @currPage / @totalPages (@progress%)
                                </MudText>
                            </div>
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Style="border-radius: 20px;"
                                       OnClick="@(() => OnOpenBook.InvokeAsync(book))">
                                Resume
                            </MudButton>
                        </div>
                    </MudCardContent>
                </MudCard>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<Book>? Books { get; set; }

    [Parameter]
    public EventCallback<Book> OnOpenBook { get; set; }
}
