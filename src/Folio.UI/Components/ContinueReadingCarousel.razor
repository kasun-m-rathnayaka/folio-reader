@if (Books is { Count: > 0 })
{
    <section class="folio-continue-section"><div class="folio-section-heading"><h2>Continue reading</h2><span class="folio-muted">Right where you left off</span></div>
        <div class="folio-continue-row">
            @foreach (var book in Books)
            {
                var page = Math.Clamp((book.ReadingPosition?.PageIndex ?? 0) + 1, 1, Math.Max(1, book.PageCount));
                var progress = (int)Math.Clamp(100.0 * page / Math.Max(1, book.PageCount), 0, 100);
                <button class="folio-resume-card" @onclick="() => OnOpenBook.InvokeAsync(book)"><BookCover Book="book" />
                    <div><span class="folio-eyebrow">PICK UP WHERE YOU LEFT OFF</span><h3>@book.Title</h3><p>@(book.Author ?? "Unknown author")</p><div class="folio-progress-track"><span style="width: @progress%;"></span></div><div class="folio-resume-footer"><span>Page @(page) of @book.PageCount</span><strong>Resume <span aria-hidden="true">→</span></strong></div></div>
                </button>
            }
        </div>
    </section>
}
@code {
    [Parameter] public IReadOnlyList<Book>? Books { get; set; }
    [Parameter] public EventCallback<Book> OnOpenBook { get; set; }
}
