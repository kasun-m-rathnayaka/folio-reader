@using Folio.Application.Reading.DTOs

<div class="folio-toc-drawer d-flex flex-column">
    <div class="d-flex justify-space-between align-center mb-3">
        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Table of Contents</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Close"
                       Size="Size.Small"
                       OnClick="@(() => OnClose.InvokeAsync())"
                       aria-label="Close Outline" />
    </div>

    @if (Outline.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">
            No embedded table of contents found in this document.
        </MudText>
    }
    else
    {
        <div style="flex: 1; overflow-y: auto;">
            @foreach (var node in Outline)
            {
                <OutlineItem Node="@node"
                             CurrentPageIndex="@CurrentPageIndex"
                             OnSelectPage="@OnSelectPage" />
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<OutlineNodeDto> Outline { get; set; } = new();
    [Parameter] public int CurrentPageIndex { get; set; }
    [Parameter] public EventCallback<int> OnSelectPage { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}
