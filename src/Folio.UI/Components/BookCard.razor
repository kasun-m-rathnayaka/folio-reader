<article class="folio-book-card @(ListMode ? "list-mode" : "")" data-book-id="@Book.Id" @oncontextmenu="OpenMenu" @oncontextmenu:preventDefault="true" @onmouseenter="() => OnFocused.InvokeAsync(Book)" @onfocusin="() => OnFocused.InvokeAsync(Book)">
    <button class="folio-book-open" @onclick="() => OnOpen.InvokeAsync(Book)" disabled="@Trash" aria-label="@BookGeometry.AccessibleName(Book)">
        <CssBook Book="Book" Height="@(ListMode ? 64 : 176)" Pose="@(ListMode ? CssBook.BookPose.Front : CssBook.BookPose.ThreeQuarter)" Interactive="@(!ListMode && !Trash)" />
        <div class="folio-book-details"><h3 title="@Book.Title">@Book.Title</h3><p>@(string.IsNullOrWhiteSpace(Book.Author) ? "Unknown author" : Book.Author)</p>
            <div class="folio-book-meta"><span class="folio-status-dot @Book.Status.ToString().ToLowerInvariant()"></span><span>@StatusText</span><span class="folio-book-pages">@Book.PageCount @(Book.PageCount == 1 ? "page" : "pages")</span></div>
            @if (Book.Status == ReadingStatus.Reading) { <div class="folio-progress-track"><span style="width: @Progress%;"></span></div> }
        </div>
    </button>
    <div class="folio-book-menu"><MudMenu @ref="_menu" PopoverClass="folio-action-menu" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
        <ActivatorContent><button type="button" class="folio-icon-button folio-book-menu-button" aria-label="@($"Actions for {Book.Title}")" aria-haspopup="menu"><MudIcon Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" /></button></ActivatorContent>
        <ChildContent>
        @if (Trash)
        {
            <MudMenuItem Icon="@Icons.Material.Outlined.Restore" OnClick="() => OnRemove.InvokeAsync(Book)">Restore book</MudMenuItem>
            <MudMenuItem Class="folio-menu-danger" Icon="@Icons.Material.Outlined.DeleteForever" OnClick="() => OnDelete.InvokeAsync(Book)">Delete permanently</MudMenuItem>
        }
        else
        {
            <MudMenuItem Icon="@Icons.Material.Outlined.AutoStories" OnClick="() => OnOpen.InvokeAsync(Book)">Read book</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="() => OnEdit.InvokeAsync(Book)">Edit details &amp; shelves</MudMenuItem>
            <MudDivider />
            <MudMenuItem Icon="@Icons.Material.Outlined.BookmarkBorder" Class="@(Book.Status == ReadingStatus.WantToRead ? "folio-menu-selected" : "")" OnClick="() => OnStatusChanged.InvokeAsync((Book, ReadingStatus.WantToRead))">Want to read</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.AutoStories" Class="@(Book.Status == ReadingStatus.Reading ? "folio-menu-selected" : "")" OnClick="() => OnStatusChanged.InvokeAsync((Book, ReadingStatus.Reading))">Reading</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.CheckCircle" Class="@(Book.Status == ReadingStatus.Finished ? "folio-menu-selected" : "")" OnClick="() => OnStatusChanged.InvokeAsync((Book, ReadingStatus.Finished))">Finished</MudMenuItem>
            <MudDivider /><MudMenuItem Class="folio-menu-danger" Icon="@Icons.Material.Outlined.Delete" OnClick="() => OnRemove.InvokeAsync(Book)">Move to Trash</MudMenuItem>
        }
        </ChildContent>
    </MudMenu></div>
</article>
@code {
    [Parameter, EditorRequired] public Book Book { get; set; } = default!;
    [Parameter] public bool ListMode { get; set; }
    [Parameter] public bool Trash { get; set; }
    [Parameter] public EventCallback<Book> OnOpen { get; set; }
    [Parameter] public EventCallback<(Book, ReadingStatus)> OnStatusChanged { get; set; }
    [Parameter] public EventCallback<Book> OnRemove { get; set; }
    [Parameter] public EventCallback<Book> OnEdit { get; set; }
    [Parameter] public EventCallback<Book> OnDelete { get; set; }
    private MudMenu? _menu;
    /// <summary>Right-click or the context-menu key opens the same menu as the [ ⋯ ] button.</summary>
    private async Task OpenMenu(MouseEventArgs e) { if (_menu != null) await _menu.OpenMenuAsync(e); }
    [Parameter] public EventCallback<Book> OnFocused { get; set; }
    private string StatusText => Book.Status switch { ReadingStatus.WantToRead => "Want to read", ReadingStatus.Reading => "Reading", _ => "Finished" };
    private int Progress => BookGeometry.ProgressPercent(Book);
}
