@using Folio.Application.Study
@using Folio.Domain.Study
@inject IStudyService StudyService
@inject NotificationService Notifications

<MudDialog Style="background: #1E1E1E; color: #FFFFFF; border: 1px solid #333333; border-radius: 8px; min-width: 600px; max-width: 750px; min-height: 480px;">
    <TitleContent>
        <div class="d-flex align-center justify-space-between">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.School" Style="color: #8C9EFF;" Size="Size.Medium" />
                <MudText Typo="Typo.h6" Style="font-weight: 600; color: #FFFFFF;">
                    Study Tools · @BookTitle
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3"
                 SliderColor="Color.Primary" Style="background: transparent;">
            
            <!-- Tab 1: Flashcards Review (SM-2) -->
            <MudTabPanel Text="Flashcards" Icon="@Icons.Material.Filled.Style">
                @if (_loadingCards)
                {
                    <div class="d-flex justify-center py-8">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </div>
                }
                else if (_dueCards.Count == 0)
                {
                    <div class="d-flex flex-column align-center justify-center py-8 text-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color: #81C784; font-size: 48px;" />
                        <MudText Typo="Typo.subtitle1" Style="color: #FFFFFF; font-weight: 600;">
                            All caught up!
                        </MudText>
                        <MudText Typo="Typo.body2" Style="color: #9E9E9E;">
                            No cards due for review. Highlights you save will generate new cards automatically.
                        </MudText>
                    </div>
                }
                else if (_currentCardIndex < _dueCards.Count)
                {
                    var currentCard = _dueCards[_currentCardIndex];
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex justify-space-between align-center">
                            <span style="font-size: 12px; color: #9E9E9E; font-weight: 500;">
                                Card @(_currentCardIndex + 1) of @_dueCards.Count · Repetition @currentCard.RepetitionNumber
                            </span>
                            <span style="font-size: 11px; color: #8C9EFF; background: rgba(140, 158, 255, 0.1); padding: 2px 8px; border-radius: 4px;">
                                EF @currentCard.EasinessFactor.ToString("0.0")
                            </span>
                        </div>

                        <!-- Card Face -->
                        <div style="background: #252525; border: 1px solid #383838; border-radius: 8px; padding: 24px; min-height: 140px; display: flex; flex-direction: column; justify-content: center;">
                            <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: #8C9EFF; margin-bottom: 8px; font-weight: 600;">
                                Question
                            </div>
                            <div style="font-size: 15px; color: #FFFFFF; font-weight: 500;">
                                @currentCard.Front
                            </div>

                            @if (_isAnswerRevealed)
                            {
                                <div style="margin-top: 16px; padding-top: 16px; border-top: 1px dashed #444444;">
                                    <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: #81C784; margin-bottom: 8px; font-weight: 600;">
                                        Answer
                                    </div>
                                    <div style="font-size: 14px; color: #E0E0E0; line-height: 1.5;">
                                        @currentCard.Back
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Controls -->
                        @if (!_isAnswerRevealed)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => _isAnswerRevealed = true)"
                                       Style="text-transform: none; font-weight: 600; width: 100%;">
                                Reveal Answer (Space)
                            </MudButton>
                        }
                        else
                        {
                            <div class="d-flex gap-1 justify-space-between mt-2">
                                <MudButton Variant="Variant.Outlined" Style="color: #FF5252; border-color: #FF5252; text-transform: none; font-size: 11px; flex: 1;"
                                           OnClick="@(() => HandleRate(0))">
                                    0 - Blackout
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Style="color: #FF7043; border-color: #FF7043; text-transform: none; font-size: 11px; flex: 1;"
                                           OnClick="@(() => HandleRate(2))">
                                    2 - Hard
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Style="color: #64B5F6; border-color: #64B5F6; text-transform: none; font-size: 11px; flex: 1;"
                                           OnClick="@(() => HandleRate(3))">
                                    3 - Good
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Style="color: #81C784; border-color: #81C784; text-transform: none; font-size: 11px; flex: 1;"
                                           OnClick="@(() => HandleRate(5))">
                                    5 - Perfect
                                </MudButton>
                            </div>
                        }
                    </div>
                }
            </MudTabPanel>

            <!-- Tab 2: Vocabulary List -->
            <MudTabPanel Text="Vocabulary" Icon="@Icons.Material.Filled.Translate">
                @if (_vocabulary.Count == 0)
                {
                    <div class="py-8 text-center" style="color: #9E9E9E;">
                        No vocabulary words saved yet. Highlight a word and select "Define & Explain" to save it here.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2" style="max-height: 300px; overflow-y: auto;">
                        @foreach (var item in _vocabulary)
                        {
                            <div style="background: #252525; border: 1px solid #333333; border-radius: 6px; padding: 12px;">
                                <div class="d-flex justify-space-between align-center">
                                    <span style="font-weight: 600; font-size: 14px; color: #8C9EFF;">@item.Word</span>
                                    <span style="font-size: 11px; color: #757575;">Page @(item.PageIndex + 1)</span>
                                </div>
                                <div style="font-size: 12px; color: #E0E0E0; margin-top: 4px;">
                                    @item.Definition
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.ContextSnippet))
                                {
                                    <div style="font-size: 11px; color: #9E9E9E; font-style: italic; margin-top: 4px;">
                                        "@item.ContextSnippet"
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </MudTabPanel>

            <!-- Tab 3: Chapter Summary -->
            <MudTabPanel Text="Chapter Summary" Icon="@Icons.Material.Filled.MenuBook">
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-center gap-2">
                        <MudTextField @bind-Value="_chapterTitleInput" Label="Chapter Title" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Style="background: #252525; color: #FFFFFF;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GenerateSummaryAsync"
                                   Disabled="@_isSummarizing" Style="text-transform: none; white-space: nowrap;">
                            @(_isSummarizing ? "Summarizing..." : "Generate Summary")
                        </MudButton>
                    </div>

                    @if (_isSummarizing)
                    {
                        <div class="d-flex justify-center py-6">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_activeSummaryMarkdown))
                    {
                        <div style="background: #252525; border: 1px solid #333333; border-radius: 6px; padding: 16px; font-size: 13px; line-height: 1.6; color: #E0E0E0; max-height: 250px; overflow-y: auto; white-space: pre-wrap;">
                            @_activeSummaryMarkdown
                        </div>
                    }
                </div>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Close" Style="color: #9E9E9E; text-transform: none;">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid BookId { get; set; }
    [Parameter] public string BookTitle { get; set; } = "";
    [Parameter] public int CurrentPageIndex { get; set; } = 0;
    [Parameter] public string CurrentPageText { get; set; } = "";

    private List<Flashcard> _dueCards = new();
    private List<VocabularyItem> _vocabulary = new();
    private int _currentCardIndex = 0;
    private bool _isAnswerRevealed = false;
    private bool _loadingCards = true;

    private string _chapterTitleInput = "Current Section";
    private string _activeSummaryMarkdown = "";
    private bool _isSummarizing = false;

    protected override async Task OnInitializedAsync()
    {
        _chapterTitleInput = $"Page {CurrentPageIndex + 1} Section";
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loadingCards = true;
        try
        {
            var stats = await StudyService.GetStudyStatsAsync(BookId);
            var due = await StudyService.GetOrGenerateChapterSummaryAsync(BookId, "dummy", 0, 0, ""); // warms cache
        }
        catch { }
        finally
        {
            _loadingCards = false;
        }
    }

    private async Task HandleRate(int quality)
    {
        if (_currentCardIndex < _dueCards.Count)
        {
            var card = _dueCards[_currentCardIndex];
            await StudyService.ReviewFlashcardAsync(card.Id, quality);
            _currentCardIndex++;
            _isAnswerRevealed = false;
            Notifications.Add(quality >= 3 ? "Review recorded!" : "Scheduled for re-test tomorrow.", Severity.Info);
        }
    }

    private async Task GenerateSummaryAsync()
    {
        _isSummarizing = true;
        try
        {
            var summary = await StudyService.GetOrGenerateChapterSummaryAsync(
                BookId,
                _chapterTitleInput,
                CurrentPageIndex,
                CurrentPageIndex + 5,
                CurrentPageText);
            _activeSummaryMarkdown = summary.SummaryMarkdown;
        }
        catch (Exception ex)
        {
            _activeSummaryMarkdown = $"Failed to generate summary: {ex.Message}";
        }
        finally
        {
            _isSummarizing = false;
        }
    }

    private void Close() => MudDialog.Cancel();
}
