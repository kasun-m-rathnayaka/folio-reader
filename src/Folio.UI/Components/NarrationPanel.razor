@using Folio.Application.Audio
@using System.Text.RegularExpressions
@implements IAsyncDisposable
@inject INarrationService Speech
@inject IDocumentTextService Text
@inject IAppPreferencesService Preferences
@inject NotificationService Notifications
<section class="folio-narration" aria-label="Read aloud">
    <div class="folio-narration-controls">
        <strong>Read aloud</strong>
        <button class="folio-icon-button" aria-label="Read previous page" disabled="@(PageIndex == 0)" @onclick="() => Jump(-1)"><MudIcon Icon="@Icons.Material.Filled.SkipPrevious" /></button>
        <button class="folio-primary-btn" disabled="@(_voices.Count == 0 || _preparing)" @onclick="PlayPause">@(_preparing ? "Preparing…" : _playing && !_paused ? "Pause" : _paused ? "Resume" : "Play")</button>
        <button class="folio-icon-button" aria-label="Read next page" disabled="@(PageIndex >= TotalPages - 1)" @onclick="() => Jump(1)"><MudIcon Icon="@Icons.Material.Filled.SkipNext" /></button>
        <button class="folio-subtle-btn" disabled="@(!_playing)" @onclick="Stop">Stop</button>
        <label>Voice <select aria-label="Narration voice" value="@_voice" @onchange="VoiceChanged">@foreach (var voice in _voices) { <option value="@voice.Id">@voice.Name (@voice.Language)</option> }</select></label>
        <label>Speed <select aria-label="Narration speed" value="@_speed.ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="SpeedChanged"><option value="0.75">0.75×</option><option value="1">1×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option><option value="2">2×</option></select></label>
        <button class="folio-subtle-btn" @onclick="() => _setup = !_setup">Voice setup</button>
        <button class="folio-icon-button" aria-label="Close read aloud" @onclick="Close"><MudIcon Icon="@Icons.Material.Filled.Close" /></button>
    </div>
    @if (_setup || _voices.Count == 0)
    {
        <div class="folio-voice-setup"><p>Speech uses offline Windows voice models installed on this PC. Add a voice in Windows Speech settings, then refresh the list.</p><button class="folio-subtle-btn" @onclick="Speech.OpenVoiceSettings">Add Windows voices</button><button class="folio-subtle-btn" @onclick="RefreshVoices">Refresh voices</button></div>
    }
    @if (_playing) { <p class="folio-narration-sentence" role="status">@_sentence</p> }
</section>
@code {
    [Parameter] public Guid BookId { get; set; }
    [Parameter] public int PageIndex { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public EventCallback<int> OnGoToPage { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private IReadOnlyList<NarrationVoice> _voices = [];
    private string? _voice; private string _sentence = "";
    private double _speed = 1;
    private bool _playing, _paused, _preparing, _setup, _disposed;
    private CancellationTokenSource? _cancellation; private Task? _run;
    protected override void OnInitialized() { _voice = Preferences.Current.SpeechVoiceId; _speed = Preferences.Current.SpeechRate; RefreshVoices(); }
    private void RefreshVoices() { try { _voices = Speech.GetVoices(); _voice = _voices.FirstOrDefault(v => v.Id == _voice)?.Id ?? _voices.FirstOrDefault(v => v.Language.StartsWith("en", StringComparison.OrdinalIgnoreCase))?.Id ?? _voices.FirstOrDefault()?.Id; } catch (Exception ex) { Notifications.Add(ex.Message, Severity.Error); } }
    private void VoiceChanged(ChangeEventArgs e) { _voice = e.Value?.ToString(); Preferences.Save(Preferences.Current with { SpeechVoiceId = _voice }); }
    private void SpeedChanged(ChangeEventArgs e) { if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var speed)) { _speed = Math.Clamp(speed, .5, 2); Preferences.Save(Preferences.Current with { SpeechRate = _speed }); } }
    private void PlayPause()
    {
        if (_playing) { _paused = !_paused; if (_paused) Speech.Pause(); else Speech.Resume(); return; }
        _cancellation = new(); _run = Run(PageIndex, _cancellation.Token);
    }
    private async Task Run(int start, CancellationToken ct)
    {
        _playing = true; _paused = false;
        try
        {
            for (var page = start; page < TotalPages; page++)
            {
                ct.ThrowIfCancellationRequested(); _preparing = true; _sentence = "Preparing page text…"; await InvokeAsync(StateHasChanged);
                var content = await Text.GetPageAsync(BookId, page, ct);
                await OnGoToPage.InvokeAsync(page);
                var sentences = Regex.Matches(content.Text, @"[^.!?]+[.!?]*").Select(m => m.Value.Trim()).Where(s => s.Length > 0);
                foreach (var sentence in sentences)
                {
                    // Bound each synthesis request so long paragraphs do not delay the first audio.
                    for (var offset = 0; offset < sentence.Length; offset += 500)
                    {
                        ct.ThrowIfCancellationRequested();
                        while (_paused) await Task.Delay(100, ct);
                        _sentence = sentence.Substring(offset, Math.Min(500, sentence.Length - offset)); _preparing = false; await InvokeAsync(StateHasChanged);
                        await Speech.SpeakAsync(_sentence, _voice, _speed, ct);
                    }
                }
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { if (!_disposed) Notifications.Add(ex.Message, Severity.Error, "Read aloud stopped"); }
        finally { _playing = _paused = _preparing = false; if (!_disposed) await InvokeAsync(StateHasChanged); }
    }
    private async Task Stop() { _cancellation?.Cancel(); Speech.Stop(); if (_run != null) await _run; _cancellation?.Dispose(); _cancellation = null; }
    private async Task Jump(int direction) { var wasPlaying = _playing; var target = Math.Clamp(PageIndex + direction, 0, TotalPages - 1); await Stop(); await OnGoToPage.InvokeAsync(target); if (wasPlaying) { _cancellation = new(); _run = Run(target, _cancellation.Token); } }
    private async Task Close() { await Stop(); await OnClose.InvokeAsync(); }
    public async ValueTask DisposeAsync() { _disposed = true; await Stop(); Speech.Dispose(); }
}
