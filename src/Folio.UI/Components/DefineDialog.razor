@using Folio.Application.AI
@inject ILocalAiService AiService
@inject NotificationService Notifications

<MudDialog Style="background: #1E1E1E; color: #FFFFFF; border: 1px solid #333333; border-radius: 8px; min-width: 360px; max-width: 520px;">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Style="color: #8C9EFF;" Size="Size.Small" />
            <MudText Typo="Typo.subtitle1" Style="font-weight: 600; color: #FFFFFF;">
                @Term
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_isLoading)
        {
            <div class="d-flex flex-column align-center justify-center py-4 gap-2">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                <MudText Typo="Typo.caption" Style="color: #9E9E9E;">
                    Consulting local intelligence...
                </MudText>
            </div>
        }
        else
        {
            <div style="font-size: 13px; line-height: 1.6; color: #E0E0E0; white-space: pre-wrap;">
                @_explanation
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text"
                   Size="Size.Small"
                   Style="color: #9E9E9E; text-transform: none;"
                   OnClick="Close">
            Close
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Style="text-transform: none; font-weight: 600;"
                   OnClick="AddToVocabulary">
            Save to Vocabulary
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Term { get; set; } = "";
    [Parameter] public string Context { get; set; } = "";

    private bool _isLoading = true;
    private string _explanation = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _explanation = await AiService.DefineAndExplainAsync(Term, Context);
        }
        catch (Exception ex)
        {
            _explanation = $"Unable to retrieve definition: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void AddToVocabulary()
    {
        Notifications.Add($"\"{Term}\" saved to your Vocabulary list.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Close() => MudDialog.Cancel();
}
