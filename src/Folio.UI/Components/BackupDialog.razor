@using Folio.Application.Backup
@inject IBackupService Backup
@inject IFilePickerService FilePicker
@inject IFileStore Files
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
<MudDialog>
    <TitleContent><h2>Backup &amp; restore</h2></TitleContent>
    <DialogContent>
        <p class="folio-muted">Keep a verified copy of your notes, bookmarks, reading positions, library metadata, and settings.</p>
        <MudCheckBox T="bool" @bind-Value="_includePdfs" Label="Include managed PDFs and covers" />
        <p class="folio-muted">@(_includePdfs ? "This archive can recreate your library on another device. Models and caches are excluded." : "PDFs are excluded. Keep a separate copy of your documents to restore on another device.")</p>
        <div class="folio-backup-actions"><button class="folio-primary-btn" @onclick="Create" disabled="@_busy"><MudIcon Icon="@Icons.Material.Outlined.Backup" Size="Size.Small" />Create backup</button><button class="folio-subtle-btn" @onclick="Restore" disabled="@_busy">Select backup to restore</button></div>
        @if (_busy) { <MudProgressLinear Indeterminate="true" Class="mt-4" /> }
        @if (_saved != null) { <p class="folio-backup-result">Backup saved<br /><span>@_saved</span></p> }
        @if (_error != null) { <p class="folio-error-text mt-4" role="alert">@_error</p> }
    </DialogContent>
    <DialogActions><MudButton OnClick="() => Dialog.Cancel()" Disabled="@_busy">Close</MudButton></DialogActions>
</MudDialog>
@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    private bool _busy, _includePdfs; private string? _saved, _error;
    private async Task Create()
    {
        _busy = true; _error = null;
        try { _saved = await Backup.CreateBackupAsync(Path.Combine(Files.BackupsDirectory, $"folio_{DateTime.Now:yyyyMMdd_HHmmss_fff}.zip"), includePdfFiles: _includePdfs); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
    private async Task Restore()
    {
        var path = await FilePicker.PickZipFileAsync(); if (path == null) return;
        _busy = true; _error = null;
        try
        {
            var metadata = await Backup.InspectBackupAsync(path);
            if (metadata == null) { _error = "This is not a readable Folio backup."; return; }
            var confirmed = await Dialogs.ShowMessageBox("Restore this library?", $"Replace current library data with {metadata.BooksCount} books, {metadata.AnnotationsCount} annotations, and {metadata.BookmarksCount} bookmarks from {metadata.CreatedAt.ToLocalTime():g}. A recovery snapshot of your current library will be kept.", yesText: "Restore library", cancelText: "Cancel");
            if (confirmed != true) return;
            await Backup.RestoreBackupAsync(path);
            Snackbar.Add("Library restored. Notes and positions are ready to use.", Severity.Success); Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
