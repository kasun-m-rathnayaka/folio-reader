<MudDialog Class="folio-dialog folio-confirm-dialog">
    <TitleContent><div class="folio-eyebrow">[ CONFIRM ]</div><h2 class="folio-dialog-title">@Title</h2></TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(Subject)) { <div class="folio-confirm-subject">@Subject</div> }
        <p class="folio-confirm-message">@Message</p>
        @if (!string.IsNullOrWhiteSpace(Detail)) { <p class="folio-confirm-detail">@Detail</p> }
    </DialogContent>
    <DialogActions>
        <button @ref="_cancel" type="button" class="folio-bracket" @onclick="() => Dialog.Cancel()"><span class="folio-bracket-edge" aria-hidden="true">[</span><span class="folio-bracket-label">CANCEL</span><span class="folio-bracket-edge" aria-hidden="true">]</span></button>
        <BracketButton Label="@ConfirmText.ToUpperInvariant()" AriaLabel="@ConfirmText" Plus="false" Class="is-danger" OnClick="() => Dialog.Close(DialogResult.Ok(true))" />
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public string Title { get; set; } = "Confirm action";
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public string? Subject { get; set; }
    [Parameter] public string? Detail { get; set; }
    [Parameter] public string ConfirmText { get; set; } = "Delete";
    private ElementReference _cancel;
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) await _cancel.FocusAsync(); }

    public static async Task<bool> ShowAsync(IDialogService dialogs, string title, string message, string confirmText, string? subject = null, string? detail = null)
    {
        var parameters = new DialogParameters<ConfirmActionDialog>
        {
            { x => x.Title, title }, { x => x.Message, message }, { x => x.ConfirmText, confirmText },
            { x => x.Subject, subject }, { x => x.Detail, detail }
        };
        var dialog = await dialogs.ShowAsync<ConfirmActionDialog>(title, parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        return await dialog.Result is { Canceled: false, Data: true };
    }
}
