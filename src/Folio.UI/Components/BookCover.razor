<div class="folio-cover @(_failed || string.IsNullOrWhiteSpace(Book.CoverPath) ? "is-placeholder" : "")">
    @if (!_failed && !string.IsNullOrWhiteSpace(Book.CoverPath))
    {
        <img src="@($"https://folio.covers/{Uri.EscapeDataString(Path.GetFileName(Book.CoverPath))}")" alt="" loading="lazy" @onerror="() => _failed = true" />
    }
    else
    {
        <div class="folio-cover-placeholder"><MudIcon Icon="@Icons.Material.Outlined.AutoStories" /><span>@Book.Title</span></div>
    }
</div>
@code {
    [Parameter, EditorRequired] public Book Book { get; set; } = default!;
    private bool _failed; private string? _previous;
    protected override void OnParametersSet() { if (_previous != Book.CoverPath) { _previous = Book.CoverPath; _failed = false; } }
}
