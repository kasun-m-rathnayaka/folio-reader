@inject IBookUrlResolver Urls
<div class="folio-cover @(_failed || _url == null ? "is-placeholder" : "")">
    @if (!_failed && _url != null)
    {
        <img src="@_url" alt="" loading="lazy" @onerror="() => _failed = true" />
    }
    else
    {
        <div class="folio-cover-placeholder"><MudIcon Icon="@Icons.Material.Outlined.AutoStories" /><span>@Book.Title</span></div>
    }
</div>
@code {
    [Parameter, EditorRequired] public Book Book { get; set; } = default!;
    private bool _failed; private string? _previous, _url; private bool _resolved;
    protected override async Task OnParametersSetAsync()
    {
        if (_resolved && _previous == Book.CoverPath) return;
        _previous = Book.CoverPath; _failed = false; _resolved = true;
        _url = string.IsNullOrWhiteSpace(Book.CoverPath) ? null : await Urls.GetCoverUrlAsync(Book);
    }
}
