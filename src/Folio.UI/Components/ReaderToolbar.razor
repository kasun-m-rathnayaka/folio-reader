@using Folio.Domain.Enums
<header class="folio-reader-toolbar">
    <button class="folio-icon-button" aria-label="Back to library" title="Back to library (Esc)" @onclick="OnBack"><MudIcon Icon="@Icons.Material.Outlined.LocalLibrary" Size="Size.Small" /></button>
    <button class="folio-reader-title @(IsOutlineOpen ? "active" : "")" aria-label="@($"Contents and bookmarks for {Title}")" aria-expanded="@IsOutlineOpen" title="Contents and bookmarks" @onclick="OnToggleOutline">@Title</button>
    <div class="folio-reader-page-controls"><button class="folio-icon-button" aria-label="Previous page" disabled="@(CurrentPage <= 1)" @onclick="OnPrevPage"><MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" /></button><button class="folio-page-indicator" title="Go to page (Ctrl G)" @onclick="OnOpenGoToPage">@CurrentPage <span>/ @TotalPages</span></button><button class="folio-icon-button" aria-label="Next page" disabled="@(CurrentPage >= TotalPages)" @onclick="OnNextPage"><MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" /></button></div>
    <div class="folio-reader-zoom"><button class="folio-icon-button" aria-label="Zoom out" @onclick="OnZoomOut"><MudIcon Icon="@Icons.Material.Filled.Remove" Size="Size.Small" /></button><span>@FormatZoom()</span><button class="folio-icon-button" aria-label="Zoom in" @onclick="OnZoomIn"><MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" /></button></div>
    <span class="folio-toolbar-divider"></span>
    <button class="folio-icon-button @(IsSearchOpen ? "active" : "")" aria-label="Find in book" title="Find in book (Ctrl F)" @onclick="OnToggleSearch"><MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" /></button>
    <button class="folio-icon-button @(IsDogEared ? "active" : "")" aria-label="Bookmark current page" aria-pressed="@IsDogEared" title="Bookmark current page (Ctrl D)" @onclick="OnToggleDogEar"><MudIcon Icon="@(IsDogEared ? Icons.Material.Filled.Bookmark : Icons.Material.Outlined.BookmarkBorder)" Size="Size.Small" /></button>
    <button class="folio-icon-button @(IsNotesOpen ? "active" : "")" aria-label="Margin notes" title="Margin notes" @onclick="OnToggleNotes"><MudIcon Icon="@Icons.Material.Outlined.EditNote" Size="Size.Small" /></button>
    <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" aria-label="Reader options" PopoverClass="folio-action-menu" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
        <MudMenuItem Icon="@Icons.Material.Outlined.FitScreen" OnClick="OnFitWidth">Fit width</MudMenuItem><MudMenuItem Icon="@Icons.Material.Outlined.CropFree" OnClick="OnFitPage">Fit page</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Outlined.RotateRight" OnClick="OnRotateClockwise">Rotate clockwise</MudMenuItem><MudMenuItem Icon="@Icons.Material.Outlined.ViewStream" OnClick="OnToggleLayoutMode">@(LayoutMode == ReaderViewMode.Continuous ? "Single page" : "Continuous scroll")</MudMenuItem>
        <MudDivider /><MudMenuItem Icon="@Icons.Material.Outlined.Notes" OnClick="OnOpenNotebook">Notebook</MudMenuItem><MudMenuItem Icon="@Icons.Material.Outlined.Fullscreen" OnClick="OnToggleZenMode">@(IsZenMode ? "Exit focus mode" : "Focus mode (F11)")</MudMenuItem>
    </MudMenu>
</header>
@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public double Zoom { get; set; }
    [Parameter] public ReaderViewMode LayoutMode { get; set; }
    [Parameter] public bool IsOutlineOpen { get; set; }
    [Parameter] public bool IsSearchOpen { get; set; }
    [Parameter] public bool IsZenMode { get; set; }
    [Parameter] public bool IsDogEared { get; set; }
    [Parameter] public bool IsNotesOpen { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnToggleOutline { get; set; }
    [Parameter] public EventCallback OnToggleDogEar { get; set; }
    [Parameter] public EventCallback OnToggleNotes { get; set; }
    [Parameter] public EventCallback OnOpenNotebook { get; set; }
    [Parameter] public EventCallback OnPrevPage { get; set; }
    [Parameter] public EventCallback OnNextPage { get; set; }
    [Parameter] public EventCallback OnOpenGoToPage { get; set; }
    [Parameter] public EventCallback OnZoomIn { get; set; }
    [Parameter] public EventCallback OnZoomOut { get; set; }
    [Parameter] public EventCallback OnFitWidth { get; set; }
    [Parameter] public EventCallback OnFitPage { get; set; }
    [Parameter] public EventCallback OnToggleLayoutMode { get; set; }
    [Parameter] public EventCallback OnRotateClockwise { get; set; }
    [Parameter] public EventCallback OnToggleSearch { get; set; }
    [Parameter] public EventCallback OnToggleZenMode { get; set; }
    private string FormatZoom() => Zoom == -2 ? "Fit page" : Zoom == -1 ? "Fit width" : $"{Math.Round(Zoom * 100)}%";
}
