@using Folio.Application.Reading.DTOs
@using Folio.Domain.Enums

<div class="folio-inspector-panel">
    <!-- Header: Title, Settings, Close (Matches screenshot) -->
    <div class="folio-panel-header">
        <span class="folio-panel-title">Edit &amp; Tools</span>
        <div class="folio-panel-actions">
            <MudIconButton Icon="@Icons.Material.Filled.Settings"
                           Size="Size.Small"
                           Style="color: #A0A0A0;"
                           title="Tool Settings" />
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Style="color: #A0A0A0;"
                           OnClick="@(() => OnClose.InvokeAsync())"
                           title="Close Panel" />
        </div>
    </div>

    <!-- Section 1: FORMAT TEXT (Matches screenshot uppercase header) -->
    <div class="mb-5">
        <div class="folio-section-label">FORMAT TEXT</div>

        <div class="mb-3">
            <MudSelect T="string"
                       Value="@_fontFamily"
                       ValueChanged="@OnFontChanged"
                       Dense="true"
                       Margin="Margin.Dense"
                       Variant="Variant.Outlined"
                       Style="background: #252525; color: #FFFFFF; font-size: 13px;">
                <MudSelectItem Value="@("Segoe UI")">Segoe UI</MudSelectItem>
                <MudSelectItem Value="@("Arial")">Arial</MudSelectItem>
                <MudSelectItem Value="@("Literata")">Literata</MudSelectItem>
                <MudSelectItem Value="@("Georgia")">Georgia</MudSelectItem>
                <MudSelectItem Value="@("Consolas")">Consolas</MudSelectItem>
            </MudSelect>
        </div>

        <div class="d-flex align-center gap-2 mb-3">
            <MudSelect T="int"
                       Value="@_fontSize"
                       ValueChanged="@OnFontSizeChanged"
                       Dense="true"
                       Margin="Margin.Dense"
                       Variant="Variant.Outlined"
                       Style="background: #252525; color: #FFFFFF; width: 80px; font-size: 13px;">
                <MudSelectItem Value="12">12</MudSelectItem>
                <MudSelectItem Value="14">14</MudSelectItem>
                <MudSelectItem Value="16">16</MudSelectItem>
                <MudSelectItem Value="18">18</MudSelectItem>
                <MudSelectItem Value="24">24</MudSelectItem>
            </MudSelect>

            <!-- Color Swatch (Matches lavender/periwinkle swatch from screenshot) -->
            <div class="folio-color-swatch"
                 style="background-color: @_selectedColor;"
                 title="Active Color: @_selectedColor"
                 @onclick="@CycleColor">
            </div>

            <!-- Alignment Buttons -->
            <button class="folio-subtle-btn @(_alignment == "left" ? "active" : "")"
                    @onclick='@(() => _alignment = "left")'
                    title="Align Left">
                <MudIcon Icon="@Icons.Material.Filled.FormatAlignLeft" Size="Size.Small" />
            </button>
            <button class="folio-subtle-btn @(_alignment == "center" ? "active" : "")"
                    @onclick='@(() => _alignment = "center")'
                    title="Align Center">
                <MudIcon Icon="@Icons.Material.Filled.FormatAlignCenter" Size="Size.Small" />
            </button>
            <button class="folio-subtle-btn @(_alignment == "right" ? "active" : "")"
                    @onclick='@(() => _alignment = "right")'
                    title="Align Right">
                <MudIcon Icon="@Icons.Material.Filled.FormatAlignRight" Size="Size.Small" />
            </button>
        </div>

        <!-- Typography Style Buttons (B, I, U, T) -->
        <div class="folio-icon-button-grid mb-3">
            <button class="folio-subtle-btn @(_isBold ? "active" : "")"
                    @onclick='@(() => _isBold = !_isBold)'
                    title="Bold">
                <strong>B</strong>
            </button>
            <button class="folio-subtle-btn @(_isItalic ? "active" : "")"
                    @onclick='@(() => _isItalic = !_isItalic)'
                    title="Italic">
                <em>I</em>
            </button>
            <button class="folio-subtle-btn @(_isUnderline ? "active" : "")"
                    @onclick='@(() => _isUnderline = !_isUnderline)'
                    title="Underline">
                <u>U</u>
            </button>
            <button class="folio-subtle-btn @(_isStrikethrough ? "active" : "")"
                    @onclick='@(() => _isStrikethrough = !_isStrikethrough)'
                    title="Strikethrough">
                <s>S</s>
            </button>
        </div>

        <!-- Quick Palette Dots -->
        <div class="d-flex align-center gap-2">
            @foreach (var c in _colorPalette)
            {
                <div class="folio-color-swatch"
                     style="background-color: @c; width: 18px; height: 18px; border-radius: 50%; outline: @(_selectedColor == c ? "2px solid #FFFFFF" : "none");"
                     @onclick="@(() => SelectColor(c))">
                </div>
            }
        </div>
    </div>

    <div style="height: 1px; background-color: #2B2B2B; margin: 16px 0;"></div>

    <!-- Section 2: ADJUST OBJECTS & VIEW (Matches screenshot uppercase header) -->
    <div class="mb-5">
        <div class="folio-section-label">ADJUST OBJECTS &amp; VIEW</div>

        <div class="folio-icon-button-grid mb-3">
            <button class="folio-subtle-btn" @onclick="@(() => OnRotate.InvokeAsync(-90))" title="Rotate Counter-Clockwise">
                <MudIcon Icon="@Icons.Material.Filled.RotateLeft" Size="Size.Small" />
            </button>
            <button class="folio-subtle-btn" @onclick="@(() => OnRotate.InvokeAsync(90))" title="Rotate Clockwise">
                <MudIcon Icon="@Icons.Material.Filled.RotateRight" Size="Size.Small" />
            </button>
            <button class="folio-subtle-btn" @onclick="@(() => OnFitWidth.InvokeAsync())" title="Fit Width">
                <MudIcon Icon="@Icons.Material.Filled.FitScreen" Size="Size.Small" />
            </button>
            <button class="folio-subtle-btn" @onclick="@(() => OnFitPage.InvokeAsync())" title="Fit Page">
                <MudIcon Icon="@Icons.Material.Filled.CropFree" Size="Size.Small" />
            </button>
            <button class="folio-subtle-btn @(LayoutMode == ReaderViewMode.Continuous ? "active" : "")"
                    @onclick="@(() => OnToggleLayout.InvokeAsync())"
                    title="Continuous Scroll">
                <MudIcon Icon="@Icons.Material.Filled.ViewStream" Size="Size.Small" />
            </button>
        </div>
    </div>

    <div style="height: 1px; background-color: #2B2B2B; margin: 16px 0;"></div>

    <!-- Section 3: MODIFY PAGE & CONTENTS (Matches screenshot uppercase header) -->
    <div style="flex: 1; overflow-y: auto;">
        <div class="folio-section-label">TABLE OF CONTENTS</div>

        @if (Outline.Count == 0)
        {
            <div style="font-size: 13px; color: #7E7E7E; padding: 8px 0;">
                No outline bookmarks found.
            </div>
        }
        else
        {
            @foreach (var node in Outline)
            {
                <OutlineItem Node="@node"
                             CurrentPageIndex="@CurrentPageIndex"
                             OnSelectPage="@OnSelectPage" />
            }
        }
    </div>
</div>

@code {
    [Parameter] public List<OutlineNodeDto> Outline { get; set; } = new();
    [Parameter] public int CurrentPageIndex { get; set; }
    [Parameter] public ReaderViewMode LayoutMode { get; set; } = ReaderViewMode.Continuous;

    [Parameter] public EventCallback<int> OnSelectPage { get; set; }
    [Parameter] public EventCallback<int> OnRotate { get; set; }
    [Parameter] public EventCallback OnFitWidth { get; set; }
    [Parameter] public EventCallback OnFitPage { get; set; }
    [Parameter] public EventCallback OnToggleLayout { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string _fontFamily = "Segoe UI";
    private int _fontSize = 14;
    private string _alignment = "left";
    private bool _isBold = false;
    private bool _isItalic = false;
    private bool _isUnderline = false;
    private bool _isStrikethrough = false;

    private string _selectedColor = "#8C9EFF"; // Lavender swatch default from screenshot
    private readonly string[] _colorPalette = new[]
    {
        "#1473E6", // Cobalt Blue
        "#8C9EFF", // Lavender
        "#4CAF50", // Green
        "#FFB300", // Amber
        "#E53935"  // Red
    };

    private void SelectColor(string color)
    {
        _selectedColor = color;
    }

    private void CycleColor()
    {
        int idx = Array.IndexOf(_colorPalette, _selectedColor);
        _selectedColor = _colorPalette[(idx + 1) % _colorPalette.Length];
    }

    private void OnFontChanged(string font)
    {
        _fontFamily = font;
    }

    private void OnFontSizeChanged(int size)
    {
        _fontSize = size;
    }
}
