@* Thin line icons for the sidebar (WP7): 1.25 px stroke on a 20 px grid, drawn in currentColor so they take --folio-text-muted
   (and --folio-text when active). Decorative: the label next to each one names the control. *@
<svg class="folio-icon" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "library": <path d="M3.5 3.5v13M7.5 3.5v13M11.2 4.6l3.1-.9 2.9 11.7-3.1.9z" />; break;
        case "reading": <path d="M10 5.2C8.4 4 6 3.7 3.5 4v10.5c2.5-.3 4.9 0 6.5 1.2 1.6-1.2 4-1.5 6.5-1.2V4c-2.5-.3-4.9 0-6.5 1.2zM10 5.2v10.5" />; break;
        case "want": <path d="M5.5 3.5h9v13L10 13l-4.5 3.5z" />; break;
        case "finished": <g><circle cx="10" cy="10" r="6.5" /><path d="M7 10.2l2 2 4-4.4" /></g>; break;
        case "shelf": <path d="M3 16.5h14M5.5 16.5V7.5M8.5 16.5V4.5M11.5 16.5V8M14.5 16.5V5.5" />; break;
        case "trash": <path d="M4.5 6h11M8 6V4.2h4V6M5.8 6l.7 10h7l.7-10M8.5 8.5v5M11.5 8.5v5" />; break;
        case "settings": <g><path d="M3.5 6h5.2M13 6h3.5M3.5 14h2.2M10 14h6.5" /><circle cx="10.8" cy="6" r="2" /><circle cx="7.9" cy="14" r="2" /></g>; break;
    }
</svg>
@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
}
