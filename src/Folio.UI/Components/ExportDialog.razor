@using Folio.Application.Annotations
@using Folio.Application.Annotations.DTOs
@inject IAnnotationExportService ExportService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2" style="color: #FFFFFF;">
            <MudIcon Icon="@Icons.Material.Filled.FileUpload" Style="color: #1473E6;" />
            <span style="font-weight: 600; font-size: 16px;">Export Annotations &amp; Notes</span>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="d-flex gap-2 mb-4">
            <button class="folio-subtle-btn @(_exportFormat == "markdown" ? "active" : "")"
                    @onclick='@(() => SetFormat("markdown"))'>
                Markdown (.md)
            </button>
            <button class="folio-subtle-btn @(_exportFormat == "json" ? "active" : "")"
                    @onclick='@(() => SetFormat("json"))'>
                JSON (.json)
            </button>
            <button class="folio-subtle-btn @(_exportFormat == "csv" ? "active" : "")"
                    @onclick='@(() => SetFormat("csv"))'>
                CSV (.csv)
            </button>
        </div>

        <div style="font-size: 11px; color: #8C8C8C; margin-bottom: 6px;">EXPORT PREVIEW</div>
        <textarea class="folio-input-field"
                  style="width: 100%; height: 280px; font-family: monospace; font-size: 12px; resize: none; background: #121212; color: #CCCCCC;"
                  readonly>@_previewContent</textarea>
    </DialogContent>
    <DialogActions>
        <button class="folio-subtle-btn" @onclick="Close">Close</button>
        <button class="folio-primary-btn" @onclick="CopyToClipboard">
            <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Class="mr-1" />
            Copy to Clipboard
        </button>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid BookId { get; set; }
    [Parameter] public string BookTitle { get; set; } = string.Empty;
    [Parameter] public string? Author { get; set; }
    [Parameter] public IReadOnlyList<AnnotationDto> Annotations { get; set; } = Array.Empty<AnnotationDto>();

    private string _exportFormat = "markdown";
    private string _previewContent = string.Empty;

    protected override void OnInitialized()
    {
        GenerateExport();
    }

    private void SetFormat(string format)
    {
        _exportFormat = format;
        GenerateExport();
    }

    private void GenerateExport()
    {
        _previewContent = _exportFormat switch
        {
            "json" => ExportService.ExportToJson(BookId, BookTitle, Author, Annotations),
            "csv" => ExportService.ExportToCsv(BookId, BookTitle, Annotations),
            _ => ExportService.ExportToMarkdown(BookId, BookTitle, Author, Annotations)
        };
    }

    private async Task CopyToClipboard()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _previewContent);
        Snackbar.Add("Export content copied to clipboard!", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Close() => MudDialog.Cancel();
}
